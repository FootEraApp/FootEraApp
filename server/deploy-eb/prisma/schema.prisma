model Pagamento {
  id            String          @id @default(uuid())
  usuarioId     String
  plano         String
  periodicidade Periodicidade
  metodo        MetodoPagamento
  status        PagamentoStatus @default(PENDENTE)
  valor         Decimal         @db.Decimal(10, 2)
  moeda         String          @default("BRL")
