  @@unique([ownerTipo, ownerId, conquistaId])
  @@index([ownerTipo, ownerId])
  @@index([atletaId])
  @@index([professorId])
  @@index([clubeId])
  @@index([escolinhaId])
  @@index([concluida, conquistadoEm])
}

model LoginEvent {
