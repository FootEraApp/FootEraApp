model ConquistaVinculo {
  id String @id @default(uuid())

  conquistaId String
  ownerTipo   ConquistaOwnerTipo
  ownerId     String

  atletaId    String?
  professorId String?
  clubeId     String?
  escolinhaId String?

  conquistadoEm DateTime?
  progresso     Int       @default(0)
  concluida     Boolean   @default(false)

  refTipo String?
  refId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

