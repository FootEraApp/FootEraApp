  pagoEm        DateTime?
  canceladoEm   DateTime?
  reembolsadoEm DateTime?
  updatedAt     DateTime        @updatedAt

  pagadorNome     String?
  pagadorEmail    String?
  pagadorCpf      String?
  pagadorTelefone String?

