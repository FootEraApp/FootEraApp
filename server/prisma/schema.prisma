model SessaoTreinoTurma {
  id                 String                       @id @default(uuid())
  treinoProgramadoId String
  turmaId            String
  criadorId          String
  data               DateTime
  status             StatusSessaoTreinoTurma      @default(AGENDADO)
  startedAt          DateTime?
  finishedAt         DateTime?
  observacoes        String?
  duracaoMinutosReal Int?
