generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Usuario {
  id                       String                    @id @default(uuid())
  nomeDeUsuario            String                    @unique
  senhaHash                String
  nome                     String
  email                    String                    @unique
  foto                     String?
  tipo                     TipoUsuario
  cidade                   String?
  estado                   String?
  pais                     String?
  bairro                   String?
  cpf                      String?
  dataNascimento           DateTime?
  responsavelNome          String?
  responsavelEmail         String?
  responsavelTelefone      String?
  configuracoesPrivacidade Json?
  dataCriacao              DateTime                  @default(now())
  codigo                   String?
  verified                 Boolean                   @default(false)
  administrador            Administrador?
  amigosDe                 Amigo[]                   @relation("AmigoUsuario")
  amigos                   Amigo[]                   @relation("UsuarioAmigo")
  atividadesRecentes       AtividadeRecente[]
  atleta                   Atleta?
  clube                    Clube?
  comentarios              Comentario[]
  curtidas                 Curtida[]
  desafiosCriados          DesafioEmGrupo[]          @relation("CriadorDesafioEmGrupo")
  escolinha                Escolinha?
  favoritadoPor            FavoritoUsuario[]         @relation("UsuarioFavorito")
  favoritos                FavoritoUsuario[]         @relation("UsuarioFavoritador")
  gruposDono               Grupo[]                   @relation("GruposQuePossuo")
  logsErro                 LogErro[]
  MembroGrupo              MembroGrupo[]
  mensagensEnviadas        Mensagem[]                @relation("MensagensEnviadas")
  mensagensRecebidas       Mensagem[]                @relation("MensagensRecebidas")
  mensagensReferenciando   Mensagem[]                @relation("UsuarioMensagemReferencia")
  MensagemGrupo            MensagemGrupo[]
  olheiro                  Olheiro?
  PasswordReset            PasswordReset[]
  postagens                Postagem[]
  professor                Professor?
  seguidores               Seguidor[]                @relation("Seguido")
  seguindo                 Seguidor[]                @relation("Seguidor")
  solicitacoesRecebidas    SolicitacaoTreino[]       @relation("SolicitacoesRecebidas")
  solicitacoesEnviadas     SolicitacaoTreino[]       @relation("SolicitacoesEnviadas")
  submissaoDesafios        SubmissaoDesafio[]
  submissaoEmGrupo         SubmissaoDesafioEmGrupo[]
  submissaoTreinos         SubmissaoTreino[]
  treinoRealizado          TreinoRealizado[]
  desafiosEmGrupo          DesafioEmGrupo[]          @relation("MembrosDesafioEmGrupo")
  Consentimento            Consentimento[]
}

model Professor {
  id                  String               @id @default(uuid())
  codigo              String               @unique
  cref                String?
  areaFormacao        String
  escola              String?
  fotoUrl             String?              @unique
  nome                String               @unique
  usuarioId           String?              @unique
  statusCref          StatusCref?
  qualificacoes       String[]
  certificacoes       String[]
  observacoes         AtletaObservado[]    @relation("ObservacaoProfessor")
  usuario             Usuario?             @relation(fields: [usuarioId], references: [id])
  relacoesTreinamento RelacaoTreinamento[] @relation("RelacaoProfessor")
  treinosProgramados  TreinoProgramado[]
  escolinhaId         String?
  clubeId             String?
  organizacaoId       String?

  escolinha Escolinha? @relation(fields: [escolinhaId], references: [id])
  clube     Clube?     @relation(fields: [clubeId], references: [id])

  @@index([escolinhaId])
  @@index([clubeId])
  @@index([organizacaoId])
}

model Amigo {
  id        String   @id @default(uuid())
  usuarioId String
  amigoId   String
  local     String?
  seguindo  Boolean? @default(false)
  amigo     Usuario  @relation("AmigoUsuario", fields: [amigoId], references: [id])
  usuario   Usuario  @relation("UsuarioAmigo", fields: [usuarioId], references: [id])
}

model Olheiro {
  id                 String            @id @default(uuid())
  usuarioId          String            @unique
  fotoUrl            String?
  headline           String?
  descricao          String?
  areaAtuacao        String?
  anosExperiencia    Int               @default(0)
  emailPublico       String?
  telefonePublico    String?
  siteOuLinkedin     String?
  colaboracaoClubeId String?
  reputacaoScore     Int               @default(0)
  totalIndicacoes    Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  AtletaObservado    AtletaObservado[]
  Indicacao          Indicacao[]
  colaboracaoClube   Clube?            @relation(fields: [colaboracaoClubeId], references: [id])
  usuario            Usuario           @relation(fields: [usuarioId], references: [id])

  @@index([areaAtuacao])
  @@index([colaboracaoClubeId])
}

model Mensagem {
  id        String          @id @default(uuid())
  deId      String
  paraId    String
  conteudo  String
  criadaEm  DateTime        @default(now())
  lida      Boolean         @default(false)
  atletaId  String?
  desafioId String?
  postId    String?
  tipo      TipoMensagem    @default(NORMAL)
  usuarioId String?
  atleta    Atleta?         @relation("AtletaMensagens", fields: [atletaId], references: [id])
  de        Usuario         @relation("MensagensEnviadas", fields: [deId], references: [id])
  desafio   DesafioOficial? @relation("DesafioMensagemReferencia", fields: [desafioId], references: [id])
  para      Usuario         @relation("MensagensRecebidas", fields: [paraId], references: [id])
  post      Postagem?       @relation("PostMensagemReferencia", fields: [postId], references: [id])
  usuario   Usuario?        @relation("UsuarioMensagemReferencia", fields: [usuarioId], references: [id])
}

model Atleta {
  id                           String                     @id @default(uuid())
  usuarioId                    String                     @unique
  nome                         String?
  sobrenome                    String?
  email                        String?                    @unique
  senhaHash                    String?
  idade                        Int
  cpf                          String?
  telefone1                    String?
  telefone2                    String?
  nacionalidade                String?
  naturalidade                 String?
  posicao                      PosicaoCampo?
  altura                       Decimal?
  peso                         Decimal?
  seloQualidade                String?
  foto                         String?
  categoria                    Categoria[]
  consentimento                Boolean                    @default(false)
  clubeId                      String?
  escolinhaId                  String?
  statusConexao                StatusConexao              @default(Pendente)
  dataCriacao                  DateTime                   @default(now())
  dataUltimaModificacao        DateTime?
  perfilTipoTreinoAtualizadoEm DateTime?
  pontosTotal                  Int?                       @default(0)
  perfilTipoTreino             TipoTreino?
  clube                        Clube?                     @relation(fields: [clubeId], references: [id])
  escolinha                    Escolinha?                 @relation(fields: [escolinhaId], references: [id])
  usuario                      Usuario                    @relation(fields: [usuarioId], references: [id])
  AtletaElenco                 AtletaElenco[]
  observadores                 AtletaObservado[]          @relation("ObservacaoAtleta")
  EstatisticaAtleta            EstatisticaAtleta?
  Indicacao                    Indicacao[]
  mensagens                    Mensagem[]                 @relation("AtletaMensagens")
  midias                       Midia[]
  pontuacao                    PontuacaoAtleta?
  postagens                    Postagem[]
  Ranking                      Ranking?
  relacoesTreinamento          RelacaoTreinamento[]       @relation("RelacaoAtleta")
  solicitacoesVinculo          SolicitacaoVinculo[]
  submissoesDesafio            SubmissaoDesafio[]
  SubmissaoTreino              SubmissaoTreino[]
  treinosAgendados             TreinoAgendado[]
  treinosLivres                TreinoLivre[]
  treinosRecebidos             TreinoProgramadoRecebido[]
  Video                        Video[]
  VinculoFormacao              VinculoFormacao[]
  TransferenciaFormador        TransferenciaFormador[]
  DocumentoFormador            DocumentoFormador[]

  @@index([perfilTipoTreino])
}

model TreinoProgramado {
  id                       String                      @id @default(uuid())
  codigo                   String                      @unique
  nome                     String                      @unique
  descricao                String?
  nivel                    Nivel
  dataAgendada             DateTime?
  professorId              String?
  createdAt                DateTime                    @default(now())
  categoria                Categoria[]
  dicas                    String[]
  duracao                  Int?
  escolinhaId              String?
  objetivo                 String?
  clubeId                  String?
  expiraEm                 DateTime?
  imagemUrl                String?
  metas                    String?
  naoExpira                Boolean                     @default(false)
  pontuacao                Int?
  tipoTreino               TipoTreino?
  temporarios              ExercicioTemporario[]
  treinoAgendado           TreinoAgendado[]
  clube                    Clube?                      @relation(fields: [clubeId], references: [id])
  escolinha                Escolinha?                  @relation(fields: [escolinhaId], references: [id])
  professor                Professor?                  @relation(fields: [professorId], references: [id])
  exercicios               TreinoProgramadoExercicio[]
  TreinoProgramadoRecebido TreinoProgramadoRecebido[]
  realizados               TreinoRealizado[]
}

model TreinoProgramadoExercicio {
  id                    String               @id @default(uuid())
  treinoProgramadoId    String
  exercicioId           String?
  ordem                 Int
  repeticoes            String
  exercicioTemporarioId String?
  exercicio             Exercicio?           @relation(fields: [exercicioId], references: [id])
  exercicioTemporario   ExercicioTemporario? @relation(fields: [exercicioTemporarioId], references: [id])
  treinoProgramado      TreinoProgramado     @relation(fields: [treinoProgramadoId], references: [id], onDelete: Cascade)

  @@index([treinoProgramadoId])
  @@index([exercicioId])
  @@index([exercicioTemporarioId])
}

model Exercicio {
  id                         String                      @id @default(uuid())
  codigo                     String                      @unique
  nome                       String                      @unique
  descricao                  String?
  nivel                      Nivel
  categorias                 Categoria[]
  videoDemonstrativoUrl      String?                     @unique
  treinoProgramadoExercicios TreinoProgramadoExercicio[]
}

model ExercicioTemporario {
  id                 String                      @id @default(uuid())
  treinoProgramadoId String
  codigo             String?
  nome               String
  descricao          String?
  nivel              Nivel
  categorias         Categoria[]
  treinoProgramado   TreinoProgramado            @relation(fields: [treinoProgramadoId], references: [id], onDelete: Cascade)
  treinos            TreinoProgramadoExercicio[]

  @@index([treinoProgramadoId])
}

model DesafioOficial {
  id                 String             @id @default(uuid())
  titulo             String             @unique
  descricao          String
  imagemUrl          String?            @unique
  nivel              Nivel
  categoria          Categoria[]
  createdAt          DateTime           @default(now())
  prazoSubmissao     DateTime?
  pontuacao          Int?
  regras             String?
  tipoMetrificação String?
  desafiosEmGrupo    DesafioEmGrupo[]   @relation("DesafioOficial_EmGrupo")
  mensagens          Mensagem[]         @relation("DesafioMensagemReferencia")
  submissoes         SubmissaoDesafio[]
}

model Seguidor {
  id                String  @id @default(uuid())
  seguidoUsuarioId  String
  seguidorUsuarioId String
  seguidoUsuario    Usuario @relation("Seguido", fields: [seguidoUsuarioId], references: [id])
  seguidorUsuario   Usuario @relation("Seguidor", fields: [seguidorUsuarioId], references: [id])
}

model RelacaoTreinamento {
  id          String     @id @default(uuid())
  professorId String?
  atletaId    String?
  escolinhaId String?
  clubeId     String?
  criadoEm    DateTime   @default(now())
  atleta      Atleta?    @relation("RelacaoAtleta", fields: [atletaId], references: [id])
  clube       Clube?     @relation("RelacaoClube", fields: [clubeId], references: [id])
  escolinha   Escolinha? @relation("RelacaoEscolinha", fields: [escolinhaId], references: [id])
  professor   Professor? @relation("RelacaoProfessor", fields: [professorId], references: [id])

  @@unique([professorId, atletaId, escolinhaId, clubeId])
}

model AtletaObservado {
  id           String     @id @default(uuid())
  professorId  String?
  escolinhaId  String?
  clubeId      String?
  atletaId     String
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  olheiroId    String?
  atleta       Atleta     @relation("ObservacaoAtleta", fields: [atletaId], references: [id])
  clube        Clube?     @relation("ObservacaoClube", fields: [clubeId], references: [id])
  escolinha    Escolinha? @relation("ObservacaoEscolinha", fields: [escolinhaId], references: [id])
  olheiro      Olheiro?   @relation(fields: [olheiroId], references: [id])
  professor    Professor? @relation("ObservacaoProfessor", fields: [professorId], references: [id])

  @@unique([professorId, escolinhaId, clubeId, atletaId, olheiroId])
  @@unique([professorId, escolinhaId, clubeId, olheiroId, atletaId], map: "AtletaObservado_owner_atleta_key")
  @@index([atletaId])
  @@index([professorId])
  @@index([escolinhaId])
  @@index([clubeId])
  @@index([olheiroId])
}

model Postagem {
  id                String       @id @default(uuid())
  conteudo          String       @unique
  imagemUrl         String?
  videoUrl          String?
  tipoMidia         TipoMidia?
  dataCriacao       DateTime     @default(now())
  usuarioId         String
  atletaId          String?
  clubeId           String?
  escolinhaId       String?
  compartilhamentos Int?         @default(0)
  oculto            Boolean      @default(false)
  reportedCount     Int          @default(0)
  comentarios       Comentario[]
  curtidas          Curtida[]
  logsErro          LogErro[]
  mensagens         Mensagem[]   @relation("PostMensagemReferencia")
  atleta            Atleta?      @relation(fields: [atletaId], references: [id])
  clube             Clube?       @relation(fields: [clubeId], references: [id])
  escolinha         Escolinha?   @relation(fields: [escolinhaId], references: [id])
  usuario           Usuario      @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, conteudo])
}

model Midia {
  id                 String            @id @default(uuid())
  url                String            @unique
  tipo               TipoMidia
  dataCriacao        DateTime          @default(now())
  dataEnvio          DateTime
  descricao          String
  titulo             String
  atletaId           String?
  escolinhaId        String?
  clubeId            String?
  submissaoDesafioId String?
  submissaoTreinoId  String?
  criadoEm           DateTime          @default(now())
  atleta             Atleta?           @relation(fields: [atletaId], references: [id])
  clube              Clube?            @relation(fields: [clubeId], references: [id])
  escolinha          Escolinha?        @relation(fields: [escolinhaId], references: [id])
  submissaoDesafio   SubmissaoDesafio? @relation("Midias_SubmissaoDesafio", fields: [submissaoDesafioId], references: [id])
  submissaoTreino    SubmissaoTreino?  @relation("Midias_SubmissaoTreino", fields: [submissaoTreinoId], references: [id])
}

model Escolinha {
  id                  String               @id @default(uuid())
  usuarioId           String?              @unique
  nome                String               @unique
  cnpj                String?              @unique
  telefone1           String?
  telefone2           String?
  email               String?              @unique
  siteOficial         String?
  sede                String?
  logradouro          String?
  numero              String?
  complemento         String?
  bairro              String?
  cidade              String?
  estado              String?
  pais                String?
  cep                 String?
  logo                String?
  dataCriacao         DateTime             @default(now())
  atletas             Atleta[]
  observacoes         AtletaObservado[]    @relation("ObservacaoEscolinha")
  usuario             Usuario?             @relation(fields: [usuarioId], references: [id])
  midias              Midia[]
  postagens           Postagem[]
  relacoesTreinamento RelacaoTreinamento[] @relation("RelacaoEscolinha")
  treinoProgramado    TreinoProgramado[]
  Professor           Professor[]
}

model Comentario {
  id            String            @id @default(uuid())
  conteudo      String
  dataCriacao   DateTime          @default(now())
  usuarioId     String
  postagemId    String?
  submissaoId   String?
  oculto        Boolean           @default(false)
  reportedCount Int               @default(0)
  postagem      Postagem?         @relation(fields: [postagemId], references: [id])
  submissao     SubmissaoDesafio? @relation(fields: [submissaoId], references: [id], onDelete: Cascade)
  usuario       Usuario           @relation(fields: [usuarioId], references: [id])

  @@index([postagemId])
  @@index([submissaoId])
}

model Clube {
  id          String   @id @default(uuid())
  usuarioId   String   @unique
  nome        String   @unique
  cnpj        String?  @unique
  telefone1   String?
  telefone2   String?
  email       String?  @unique
  siteOficial String?  @unique
  sede        String?
  estadio     String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  pais        String?
  cep         String?
  logo        String?
  dataCriacao DateTime @default(now())
  descricao   String?
  responsavel String?

  categorias          Categoria[]
  atletas             Atleta[]
  observacoes         AtletaObservado[]    @relation("ObservacaoClube")
  usuario             Usuario              @relation(fields: [usuarioId], references: [id])
  Evento              Evento[]
  Indicacao           Indicacao[]
  midias              Midia[]
  Olheiro             Olheiro[]
  postagens           Postagem[]
  relacoesTreinamento RelacaoTreinamento[] @relation("RelacaoClube")
  treinoProgramado    TreinoProgramado[]
  Professor           Professor[]
}

model SolicitacaoVinculo {
  id           String   @id @default(uuid())
  atletaId     String
  entidadeId   String
  tipoEntidade String
  status       String?
  criadoEm     DateTime @default(now())
  atleta       Atleta   @relation(fields: [atletaId], references: [id])
}

model SolicitacaoTreino {
  id             String   @id @default(uuid())
  remetenteId    String
  destinatarioId String
  status         String?
  criadoEm       DateTime @default(now())
  destinatario   Usuario  @relation("SolicitacoesRecebidas", fields: [destinatarioId], references: [id], onDelete: Cascade)
  remetente      Usuario  @relation("SolicitacoesEnviadas", fields: [remetenteId], references: [id], onDelete: Cascade)
}

model SubmissaoDesafio {
  id                 String                    @id @default(uuid())
  atletaId           String
  desafioId          String
  videoUrl           String                    @unique
  aprovado           Boolean?
  createdAt          DateTime                  @default(now())
  usuarioId          String?
  observacao         String?
  conteudo           Json?
  resultado          Float?
  resultadoDeclarado Float?
  tempoMs            Int?
  unidadeResultado   String?
  repeticoes         Int?
  comentarios        Comentario[]
  curtidas           Curtida[]
  midias             Midia[]                   @relation("Midias_SubmissaoDesafio")
  atleta             Atleta                    @relation(fields: [atletaId], references: [id])
  desafio            DesafioOficial            @relation(fields: [desafioId], references: [id])
  Usuario            Usuario?                  @relation(fields: [usuarioId], references: [id])
  submissaoEmGrupo   SubmissaoDesafioEmGrupo[]
}

model SubmissaoTreino {
  id                   String         @id @default(uuid())
  atletaId             String
  treinoAgendadoId     String
  aprovado             Boolean?
  observacao           String?        @unique
  criadoEm             DateTime       @default(now())
  atualizadoEm         DateTime       @updatedAt
  usuarioId            String?
  duracaoMinutos       Int?
  pontosCreditados     Int?
  pontuacaoSnapshot    Int?
  tipoTreinoSnapshot   TipoTreino?
  treinoTituloSnapshot String?
  midias               Midia[]        @relation("Midias_SubmissaoTreino")
  atleta               Atleta         @relation(fields: [atletaId], references: [id])
  treinoAgendado       TreinoAgendado @relation(fields: [treinoAgendadoId], references: [id])
  Usuario              Usuario?       @relation(fields: [usuarioId], references: [id])
  tempoSeg             Int?
  repeticoes           Int?
}

model Grupo {
  id        String           @id @default(uuid())
  nome      String
  descricao String?
  createdAt DateTime         @default(now())
  foto      String?
  ownerId   String
  updatedAt DateTime         @updatedAt
  desafios  DesafioEmGrupo[]
  owner     Usuario          @relation("GruposQuePossuo", fields: [ownerId], references: [id])
  membros   MembroGrupo[]
  mensagens MensagemGrupo[]

  @@index([ownerId])
  @@index([createdAt])
  @@index([updatedAt])
}

model MembroGrupo {
  id        String     @id @default(uuid())
  grupoId   String
  criadoEm  DateTime   @default(now())
  tipo      TipoMembro @default(MEMBRO)
  updatedAt DateTime   @updatedAt
  usuarioId String
  grupo     Grupo      @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usuario   Usuario    @relation(fields: [usuarioId], references: [id])

  @@unique([grupoId, usuarioId])
  @@index([usuarioId])
  @@index([grupoId, tipo])
}

model MensagemGrupo {
  id               String          @id @default(uuid())
  grupoId          String
  usuarioId        String
  conteudo         String
  tipo             TipoMensagem    @default(NORMAL)
  criadaEm         DateTime        @default(now())
  excluida         Boolean         @default(false)
  excluidaEm       DateTime?
  excluidaPor      String?
  conteudoJson     Json?
  desafioEmGrupoId String?
  desafioEmGrupo   DesafioEmGrupo? @relation(fields: [desafioEmGrupoId], references: [id])
  grupo            Grupo           @relation(fields: [grupoId], references: [id])
  usuario          Usuario         @relation(fields: [usuarioId], references: [id])

  @@index([grupoId])
  @@index([usuarioId])
  @@index([criadaEm])
  @@index([desafioEmGrupoId])
}

model Administrador {
  id        String  @id @default(uuid())
  usuarioId String  @unique
  cargo     String
  nivel     Nivel
  fotoUrl   String?
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}

model LogErro {
  id           String   @id @default(uuid())
  errorMessage String
  requestId    String
  timestamp    DateTime
  path         String
  clientIp     String
  postagemId   String
  usuarioId    String
  postagem     Postagem @relation(fields: [postagemId], references: [id], onDelete: Cascade)
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
}

model Curtida {
  id          String            @id @default(uuid())
  usuarioId   String
  postagemId  String?
  createdAt   DateTime          @default(now())
  submissaoId String?
  postagem    Postagem?         @relation(fields: [postagemId], references: [id], onDelete: Cascade)
  submissao   SubmissaoDesafio? @relation(fields: [submissaoId], references: [id], onDelete: Cascade)
  usuario     Usuario           @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, postagemId], name: "usuario_postagem_unique")
  @@unique([usuarioId, submissaoId], name: "usuario_submissao_unique")
  @@index([submissaoId])
}

model TreinoAgendado {
  id                 String            @id @default(uuid())
  titulo             String            @unique
  local              String?
  atletaId           String
  treinoProgramadoId String?
  dataTreino         DateTime?
  dataExpiracao      DateTime?
  submissaoTreinos   SubmissaoTreino[]
  atleta             Atleta            @relation(fields: [atletaId], references: [id])
  treinoProgramado   TreinoProgramado? @relation(fields: [treinoProgramadoId], references: [id])
}

model TreinoLivre {
  id             String           @id @default(cuid())
  atletaId       String
  atleta         Atleta           @relation(fields: [atletaId], references: [id])
  data           DateTime
  descricao      String
  duracaoMin     Int
  tipoAtividade  String?
  categoria      String?
  urlEvidencia   String?
  createdAt      DateTime         @default(now())
  RegistroTreino RegistroTreino[]
}

model RegistroTreino {
  id         String      @id @default(uuid())
  treinoId   String
  notas      String?
  completado Boolean     @default(false)
  treino     TreinoLivre @relation(fields: [treinoId], references: [id])
}

model PontuacaoAtleta {
  atletaId                  String   @id
  pontuacaoTotal            Int      @default(0)
  pontuacaoPerformance      Int      @default(0)
  pontuacaoDisciplina       Int      @default(0)
  pontuacaoResponsabilidade Int      @default(0)
  ultimaAtualizacao         DateTime @default(now())
  atleta                    Atleta   @relation(fields: [atletaId], references: [id])
}

model Video {
  id        String      @id @default(uuid())
  titulo    String
  url       String      @unique
  thumbnail String?
  atletaId  String
  createdAt DateTime    @default(now())
  categoria Categoria[]
  nivel     Nivel
  atleta    Atleta      @relation(fields: [atletaId], references: [id])
}

model Ranking {
  id        String   @id @default(uuid())
  atletaId  String   @unique
  total     Int      @default(0)
  posicao   Int
  createdAt DateTime @default(now())
  atleta    Atleta   @relation(fields: [atletaId], references: [id])
}

model ConfiguracaoSistema {
  id                     String  @id @default(uuid())
  registrationEnabled    Boolean @default(true)
  maintenanceMode        Boolean @default(false)
  allowAthleteChallenges Boolean @default(true)
  allowProfileEditing    Boolean @default(true)
  maxDailyPosts          Int     @default(5)
}

model AtividadeRecente {
  id        String   @id @default(uuid())
  usuarioId String
  tipo      String
  imagemUrl String?  @unique
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
}

model TreinoRealizado {
  id            String           @id @default(uuid())
  usuarioId     String
  treinoId      String
  local         String?
  dataExpiracao DateTime?
  treino        TreinoProgramado @relation(fields: [treinoId], references: [id])
  usuario       Usuario          @relation(fields: [usuarioId], references: [id])
}

model TreinoProgramadoRecebido {
  id       String           @id @default(uuid())
  atletaId String
  treinoId String
  atleta   Atleta           @relation(fields: [atletaId], references: [id])
  treino   TreinoProgramado @relation(fields: [treinoId], references: [id])
}

model DesafioEmGrupo {
  id               String                    @id @default(uuid())
  desafioOficialId String
  grupoId          String
  status           StatusDesafioGrupo        @default(ativo)
  dataCriacao      DateTime                  @default(now())
  dataExpiracao    DateTime?
  pontosAcumulados Int?                      @default(0)
  bonus            Int                       @default(0)
  bonusDado        Boolean                   @default(false)
  criadoPorId      String
  pontosSnapshot   Int?
  criadoPor        Usuario                   @relation("CriadorDesafioEmGrupo", fields: [criadoPorId], references: [id])
  desafioOficial   DesafioOficial            @relation("DesafioOficial_EmGrupo", fields: [desafioOficialId], references: [id])
  grupo            Grupo                     @relation(fields: [grupoId], references: [id])
  MensagemGrupo    MensagemGrupo[]
  submissaoEmGrupo SubmissaoDesafioEmGrupo[]
  membros          Usuario[]                 @relation("MembrosDesafioEmGrupo")

  @@index([grupoId])
  @@index([desafioOficialId])
  @@index([criadoPorId])
}

model SubmissaoDesafioEmGrupo {
  id                 String           @id @default(uuid())
  submissaoDesafioId String
  desafioEmGrupoId   String
  usuarioId          String
  dataEnvio          DateTime         @default(now())
  aprovado           Boolean?
  pontosGanhos       Int?
  dentroDoPrazo      Boolean          @default(false)
  desafioEmGrupo     DesafioEmGrupo   @relation(fields: [desafioEmGrupoId], references: [id])
  submissaoDesafio   SubmissaoDesafio @relation(fields: [submissaoDesafioId], references: [id])
  usuario            Usuario          @relation(fields: [usuarioId], references: [id])

  @@unique([desafioEmGrupoId, usuarioId])
  @@index([desafioEmGrupoId])
  @@index([usuarioId])
}

model PasswordReset {
  id        String    @id @default(uuid())
  usuarioId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
}

model EstatisticaAtleta {
  atletaId       String   @id
  totalTreinos   Int      @default(0)
  totalDesafios  Int      @default(0)
  totalPontos    Int      @default(0)
  horasTreinadas Float    @default(0)
  fisico         Int      @default(0)
  tecnico        Int      @default(0)
  tatico         Int      @default(0)
  mental         Int      @default(0)
  updatedAt      DateTime @updatedAt
  atleta         Atleta   @relation(fields: [atletaId], references: [id])
}

model FavoritoUsuario {
  id                String   @id @default(uuid())
  usuarioId         String
  favoritoUsuarioId String
  createdAt         DateTime @default(now())
  favorito          Usuario  @relation("UsuarioFavorito", fields: [favoritoUsuarioId], references: [id])
  usuario           Usuario  @relation("UsuarioFavoritador", fields: [usuarioId], references: [id])

  @@unique([usuarioId, favoritoUsuarioId], name: "usuarioId_favoritoUsuarioId")
  @@index([usuarioId])
  @@index([favoritoUsuarioId])
}

model Elenco {
  id            String         @id @default(uuid())
  nome          String
  professorId   String?
  clubeId       String?
  escolinhaId   String?
  atletasIds    String[]
  maxJogadores  Int            @default(11)
  ativo         Boolean        @default(true)
  dataCriacao   DateTime       @default(now())
  atletasElenco AtletaElenco[]
}

model AtletaElenco {
  id           String       @id @default(uuid())
  elencoId     String
  atletaId     String
  posicao      PosicaoCampo
  numeroCamisa Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  atleta       Atleta       @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  elenco       Elenco       @relation(fields: [elencoId], references: [id], onDelete: Cascade)

  @@unique([elencoId, posicao])
  @@unique([elencoId, atletaId])
  @@index([atletaId])
}

model Evento {
  id             String       @id @default(uuid())
  clubeId        String
  titulo         String
  tipo           EventoTipo   @default(PENEIRA)
  descricao      String?
  inicio         DateTime
  fim            DateTime?
  local          String?
  cidade         String?
  estado         String?
  pais           String?
  endereco       String?
  vagas          Int?
  valorInscricao Decimal?     @db.Decimal(10, 2)
  linkInscricao  String?
  requisitos     String[]
  status         EventoStatus @default(ABERTO)
  criadoEm       DateTime     @default(now())
  atualizadoEm   DateTime     @updatedAt
  clube          Clube        @relation(fields: [clubeId], references: [id])
}

model Indicacao {
  id           String          @id @default(uuid())
  olheiroId    String
  atletaId     String
  clubeId      String
  status       IndicacaoStatus @default(PENDENTE)
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt
  atleta       Atleta          @relation(fields: [atletaId], references: [id])
  clube        Clube           @relation(fields: [clubeId], references: [id])
  olheiro      Olheiro         @relation(fields: [olheiroId], references: [id])

  @@index([olheiroId, status])
  @@index([clubeId])
  @@index([atletaId])
}

model VinculoFormacao {
  id          String         @id @default(uuid())
  atletaId    String
  origem      OrigemFormador
  origemId    String
  inicio      DateTime?
  fim         DateTime?
  documentos  String[]
  observacoes String?
  createdAt   DateTime       @default(now())

  atleta            Atleta              @relation(fields: [atletaId], references: [id])
  DocumentoFormador DocumentoFormador[]
}

model TransferenciaFormador {
  id                 String    @id @default(uuid())
  atletaId           String
  deClubeId          String?
  paraClubeId        String?
  data               DateTime?
  valorTransferencia Decimal   @default(0)
  gerouSolidariedade Boolean   @default(false)
  valorSolidariedade Decimal   @default(0)
  createdAt          DateTime  @default(now())

  atleta Atleta @relation(fields: [atletaId], references: [id])
}

model BadgeFormador {
  id            String    @id @default(uuid())
  nome          String
  descricao     String?
  icon          String?
  iconUrl       String?
  conquistadoEm DateTime?
  createdAt     DateTime  @default(now())
}

model DocumentoFormador {
  id           String   @id @default(uuid())
  atletaId     String
  descricao    String?
  fileName     String
  originalName String
  mimeType     String
  size         Int
  path         String
  createdAt    DateTime @default(now())

  atleta            Atleta           @relation(fields: [atletaId], references: [id])
  vinculoFormacao   VinculoFormacao? @relation(fields: [vinculoFormacaoId], references: [id])
  vinculoFormacaoId String?
}

model ScoutNote {
  id            String   @id @default(uuid())
  olheiroId     String
  atletaId      String
  texto         String   @default("")
  lastScoreSeen Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([olheiroId, atletaId], name: "olheiroId_atletaId")
}

model TreinoUsuario {
  id          String       @id @default(uuid())
  treinoId    String
  usuarioId   String
  status      TreinoStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  tempoSeg    Int?
  repeticoes  Int?
  observacao  String?

  @@unique([treinoId, usuarioId])
}

model ChecklistTemplate {
  id          String           @id @default(uuid())
  context     ChecklistContext
  nome        String
  ativo       Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       ChecklistItem[]
  professorId String?
  clubeId     String?
  escolinhaId String?
}

model ChecklistItem {
  id         String            @id @default(uuid())
  templateId String
  ordem      Int               @default(0)
  label      String
  key        String
  type       ChecklistItemType
  required   Boolean           @default(false)
  weight     Int               @default(1)
  options    String[]
  template   ChecklistTemplate @relation(fields: [templateId], references: [id])
}

model SubmissionChecklist {
  id                 String           @id @default(uuid())
  templateId         String
  context            ChecklistContext
  submissaoTreinoId  String?
  submissaoDesafioId String?
  postagemId         String?
  totalScore         Int?
  aprovado           Boolean?
  finalizedByUserId  String?
  finalizedAt        DateTime?
  createdAt          DateTime         @default(now())

  answers ChecklistAnswer[]
}

model ChecklistAnswer {
  id                  String              @id @default(uuid())
  checklistId         String
  itemId              String
  value               Json?
  comment             String?
  SubmissionChecklist SubmissionChecklist @relation(fields: [checklistId], references: [id])
}

model RankingSnapshot {
  id          String       @id @default(uuid())
  kind        String
  ref         String?
  generatedAt DateTime     @default(now())
  rows        RankingRow[]
}

model RankingRow {
  id                String           @id @default(uuid())
  snapshotId        String
  atletaId          String
  posicao           Int
  pontuacao         Int
  estado            String?
  categoria         String?
  RankingSnapshot   RankingSnapshot? @relation(fields: [rankingSnapshotId], references: [id])
  rankingSnapshotId String?
}

model Consentimento {
  id           String   @id @default(uuid())
  usuarioId    String
  tipo         String
  doc          String
  versaoTermos String
  versaoPriv   String
  hashTermos   String?
  hashPriv     String?
  metodo       String
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
}

enum TreinoStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum ChecklistContext {
  SUBMISSAO_TREINO
  SUBMISSAO_DESAFIO
  POSTAGEM
  PENEIRA
}

enum ChecklistItemType {
  BOOLEAN
  SELECT
  SCORE
}

enum OrigemFormador {
  Escolinha
  Clube
}

enum IndicacaoStatus {
  PENDENTE
  APROVADA
  REJEITADA
}

enum PosicaoCampo {
  GOL
  LD
  ZD
  ZE
  LE
  VOL1
  VOL2
  MEI
  PD
  CA
  PE
}

enum StatusDesafioGrupo {
  ativo
  concluido
  expirado
}

enum Nivel {
  Base
  Avancado
  Performance
}

enum Categoria {
  Sub9
  Sub11
  Sub13
  Sub15
  Sub17
  Sub20
  Livre
}

enum TipoUsuario {
  Atleta
  Professor
  Clube
  Escolinha
  Admin
  Olheiro
}

enum TipoMidia {
  Imagem
  Video
  Documento
}

enum StatusConexao {
  Pendente
  Aprovado
  Recusado
}

enum StatusCref {
  Ativo
  Desativo
  Pendente
}

enum TipoTreino {
  Tecnico
  Fisico  @map("Físico")
  Tatico
  Mental
}

enum TipoMensagem {
  NORMAL
  DESAFIO
  POST
  USUARIO
  CONQUISTA
  GRUPO_DESAFIO
  GRUPO_DESAFIO_BONUS
  CARD
}

enum TipoMembro {
  DONO
  ADMIN
  MEMBRO
}

enum EventoTipo {
  PENEIRA
  EVENTO
}

enum EventoStatus {
  ABERTO
  ENCERRADO
  CANCELADO
}
