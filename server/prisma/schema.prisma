  @@index([tipo])
  @@index([ativo])
}

model ConquistaVinculo {
  id                String             @id @default(uuid())
  conquistaId       String
  ownerTipo         ConquistaOwnerTipo
  ownerId           String
  atletaId          String?
  professorId       String?
  clubeId           String?
  escolinhaId       String?
  conquistadoEm     DateTime?
  progresso         Int                @default(0)
  concluida         Boolean            @default(false)
  refTipo           String?
  refId             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  federacaoId       String?
  learningProfileId String?
  marcaId           String?
  atleta            Atleta?            @relation("ConquistaAtleta", fields: [atletaId], references: [id], onDelete: Cascade)
  clube             Clube?             @relation("ConquistaClube", fields: [clubeId], references: [id], onDelete: Cascade)
  conquista         Conquista          @relation(fields: [conquistaId], references: [id], onDelete: Cascade)
  escolinha         Escolinha?         @relation("ConquistaEscolinha", fields: [escolinhaId], references: [id], onDelete: Cascade)
  federacao         Federacao?         @relation(fields: [federacaoId], references: [id], onDelete: SetNull)
  learningProfile   LearningProfile?   @relation(fields: [learningProfileId], references: [id], onDelete: SetNull)
  marca             Marca?             @relation(fields: [marcaId], references: [id], onDelete: SetNull)
  professor         Professor?         @relation("ConquistaProfessor", fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([ownerTipo, ownerId, conquistaId])
  @@index([ownerTipo, ownerId])
  @@index([atletaId])
  @@index([professorId])
  @@index([clubeId])
  @@index([escolinhaId])
  @@index([concluida, conquistadoEm])
}

model LoginEvent {
