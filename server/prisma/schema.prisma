model CreatorVenda {
  id                  String             @id @default(uuid())
  creatorId           String
  compradorId         String?
  metodologiaId       String?
  metodologiaAvulsaId String?
  valorBruto          Decimal            @db.Decimal(10, 2)
  percentualFootera   Decimal            @default(0.15) @db.Decimal(5, 4)
  valorFootera        Decimal            @db.Decimal(10, 2)
  valorCreator        Decimal            @db.Decimal(10, 2)
