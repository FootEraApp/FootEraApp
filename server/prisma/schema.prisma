generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Usuario {
  id                              String                        @id @default(uuid())
  nomeDeUsuario                   String                        @unique
  senhaHash                       String
  nome                            String
  email                           String                        @unique
  foto                            String?
  tipo                            TipoUsuario
  cidade                          String?
  estado                          String?
  pais                            String?
  cpf                             String?
  dataNascimento                  DateTime?
  responsavelNome                 String?
  responsavelEmail                String?
  responsavelTelefone             String?
  configuracoesPrivacidade        Json?
  dataCriacao                     DateTime                      @default(now())
  codigo                          String?
  verified                        Boolean                       @default(false)
  destaque                        Boolean                       @default(false)
  configuracoesNotificacoes       Json?
  senhaAtualizadaEm               DateTime?
  tokenVersion                    Int                           @default(0)
  parceiro                        Boolean                       @default(false)
  lastLoginAt                     DateTime?
  lastLogoutAt                    DateTime?
  lastSeenAt                      DateTime?
  deleteScheduledAt               DateTime?
  deletedAt                       DateTime?
  blockedAt                       DateTime?
  blockedReason                   String?
  reactivatedAt                   DateTime?
  status                          AccountStatus                 @default(ATIVO)
  cep                             String?
  authProvider                    AuthProvider                  @default(LOCAL)
  googleEmail                     String?
  googleLinkedAt                  DateTime?
  googlePicture                   String?
  googleSub                       String?                       @unique
  logradouro                      String?
  administrador                   Administrador?
  amigosDe                        Amigo[]                       @relation("AmigoUsuario")
  amigos                          Amigo[]                       @relation("UsuarioAmigo")
  assinatura                      Assinatura[]
  atividadesRecentes              AtividadeRecente[]
  atleta                          Atleta?
  aulasAoVivoComoConvidado        AulaAoVivo[]                  @relation("AulaAoVivoConvidado")
  aulasAoVivoCriadas              AulaAoVivo[]                  @relation("AulaAoVivoCriador")
  aulasAoVivoAcessos              AulaAoVivoAcesso[]
  aulasAoVivoComoConvidadoEmLista AulaAoVivoConvidado[]         @relation("AulaAoVivoConvidadoUsuario")
  aulasAoVivoMensagensDeletadas   AulaAoVivoMensagem[]          @relation("AulaAoVivoMensagemDeletadaPor")
  aulasAoVivoMensagens            AulaAoVivoMensagem[]          @relation("AulaAoVivoMensagemUsuario")
  aulasAoVivoPresencas            AulaAoVivoPresenca[]          @relation("AulaAoVivoPresencaUsuario")
  AvaliacaoMetodologia            AvaliacaoMetodologia[]
  AvaliacaoTreino                 AvaliacaoTreino[]
  certificadosMetodologia         CertificadoMetodologia[]
  clube                           Clube?
  comentarios                     Comentario[]
  Consentimento                   Consentimento[]
  creator                         Creator?
  comprasCreator                  CreatorVenda[]                @relation("CreatorVendaComprador")
  Cupom                           Cupom[]
  CupomResgate                    CupomResgate[]
  curtidas                        Curtida[]
  desafiosCriados                 DesafioEmGrupo[]              @relation("CriadorDesafioEmGrupo")
  EmailVerification               EmailVerification?
  escolinha                       Escolinha?
  ExercicioPersonalizado          ExercicioPersonalizado[]
  favoritadoPor                   FavoritoUsuario[]             @relation("UsuarioFavorito")
  favoritos                       FavoritoUsuario[]             @relation("UsuarioFavoritador")
  federacao                       Federacao?
  feedbacks                       Feedback[]
  gruposDono                      Grupo[]                       @relation("GruposQuePossuo")
  convitesEvento                  InscricaoEvento[]             @relation("ConvitesEvento")
  inscricoesEvento                InscricaoEvento[]
  learningFavoritos               LearningFavorito[]
  learningProfile                 LearningProfile?
  lembretesNotificacaoEnviados    LembreteNotificacaoEnviado[]
  LogAuditoria                    LogAuditoria[]
  logsErro                        LogErro[]
  LoginEvent                      LoginEvent[]
  marca                           Marca?
  MembroGrupo                     MembroGrupo[]
  mensagensEnviadas               Mensagem[]                    @relation("MensagensEnviadas")
  mensagensRecebidas              Mensagem[]                    @relation("MensagensRecebidas")
  mensagensReferenciando          Mensagem[]                    @relation("UsuarioMensagemReferencia")
  MensagemGrupo                   MensagemGrupo[]
  metodologiasCriadas             Metodologia[]                 @relation("MetodologiaCriador")
  metodologiasAssinadas           MetodologiaAssinante[]
  metodologiasAvulsasCriadas      MetodologiaAvulsa[]           @relation("MetodologiaAvulsaCriador")
  MetodologiaItemSubmissao        MetodologiaItemSubmissao[]
  notificacoesGeradas             Notificacao[]                 @relation("NotificacaoActor")
  notificacoes                    Notificacao[]                 @relation("NotificacaoUsuario")
  olheiro                         Olheiro?
  Pagamento                       Pagamento[]
  parceiroInfo                    Parceiro?
  PasswordReset                   PasswordReset[]
  postagens                       Postagem[]
  professor                       Professor?
  pushDeviceTokens                PushDeviceToken[]
  pushSubscriptions               PushSubscription[]
  seguidores                      Seguidor[]                    @relation("Seguido")
  seguindo                        Seguidor[]                    @relation("Seguidor")
  SessaoTreinoTurma               SessaoTreinoTurma[]
  solicitacoesRecebidas           SolicitacaoTreino[]           @relation("SolicitacoesRecebidas")
  solicitacoesEnviadas            SolicitacaoTreino[]           @relation("SolicitacoesEnviadas")
  submissaoDesafios               SubmissaoDesafio[]
  submissaoEmGrupo                SubmissaoDesafioEmGrupo[]
  submissaoTreinos                SubmissaoTreino[]
  SubmissionChecklist             SubmissionChecklist[]
  treinosFavoritos                TreinoFavorito[]
  treinosCriadosComoAdmin         TreinoProgramado[]            @relation("TreinoProgramadoCriadorUsuario")
  treinoRealizado                 TreinoRealizado[]
  TreinoRotina                    TreinoRotina[]
  TreinoSalvo                     TreinoSalvo[]
  TreinoUsuario                   TreinoUsuario[]
  Turmas                          TurmaUsuario[]
  desafiosEmGrupo                 DesafioEmGrupo[]              @relation("MembrosDesafioEmGrupo")
  visualizacoesPontuacaoFeitas    PerfilPontuacaoVisualizacao[] @relation("PerfilPontuacaoViewer")
  visualizacoesPontuacaoRecebidas PerfilPontuacaoVisualizacao[] @relation("PerfilPontuacaoAlvo")

  @@index([deletedAt])
  @@index([deleteScheduledAt])
}

model PerfilPontuacaoVisualizacao {
  id                   String   @id @default(uuid())
  viewerUsuarioId      String
  perfilUsuarioId      String
  ultimaPontuacaoVista Int      @default(0)
  visualizadoEm        DateTime @default(now())
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  viewer Usuario @relation("PerfilPontuacaoViewer", fields: [viewerUsuarioId], references: [id], onDelete: Cascade)

  perfil Usuario @relation("PerfilPontuacaoAlvo", fields: [perfilUsuarioId], references: [id], onDelete: Cascade)

  @@unique([viewerUsuarioId, perfilUsuarioId])
  @@index([viewerUsuarioId])
  @@index([perfilUsuarioId])
}

model GooglePreCadastro {
  id            String   @id @default(uuid())
  token         String   @unique
  googleSub     String
  email         String
  emailVerified Boolean  @default(false)
  nome          String?
  foto          String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([googleSub])
  @@index([email])
  @@index([expiresAt])
}

model Parceiro {
  id           String   @id @default(uuid())
  usuarioId    String   @unique
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model EmailVerification {
  id        String    @id @default(uuid())
  usuarioId String    @unique
  token     String    @unique
  criadoEm  DateTime  @default(now())
  expiraEm  DateTime
  usadoEm   DateTime?
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Assinatura {
  id                        String           @id @default(uuid())
  usuarioId                 String
  plano                     String
  periodicidade             Periodicidade
  startsAt                  DateTime
  renovaEm                  DateTime
  canceledAt                DateTime?
  ativo                     Boolean          @default(true)
  lembreteEnviado           Boolean          @default(false)
  providerSubscriptionId    String?          @unique
  bloqueadoEm               DateTime?
  metodoPreferido           MetodoPagamento?
  metodoPreferidoDefinidoEm DateTime?
  status                    AssinaturaStatus @default(TRIAL)
  trialEndsAt               DateTime?
  trialStartsAt             DateTime?
  usuario                   Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, plano])
  @@index([startsAt])
  @@index([canceledAt])
  @@index([status])
  @@index([trialEndsAt])
}

model Professor {
  id                          String                      @id @default(uuid())
  codigo                      String?
  cref                        String?
  areaFormacao                String?
  escola                      String?
  fotoUrl                     String?
  nome                        String
  usuarioId                   String?                     @unique
  statusCref                  StatusCref?
  qualificacoes               String[]
  certificacoes               String[]
  escolinhaId                 String?
  clubeId                     String?
  organizacaoId               String?
  email                       String?                     @db.VarChar(191)
  dataNascimento              DateTime?
  descricao                   String?
  AtletaHistoricoVinculo      AtletaHistoricoVinculo[]
  observacoes                 AtletaObservado[]           @relation("ObservacaoProfessor")
  conquistas                  ConquistaVinculo[]          @relation("ConquistaProfessor")
  estatExerciciosRecomendados EstatisticaExercicio[]      @relation("ExEstRec_Rec")
  estatExerciciosUltimo       EstatisticaExercicio[]      @relation("ExEstRec_Ult")
  Metodologia                 Metodologia[]
  MetodologiaAvulsa           MetodologiaAvulsa[]
  olheirosColaboradores       Olheiro[]                   @relation("OlheiroColabProfessor")
  OrganizacaoGestor           OrganizacaoGestor[]
  Clube                       Clube?                      @relation(fields: [clubeId], references: [id])
  Escolinha                   Escolinha?                  @relation(fields: [escolinhaId], references: [id])
  usuario                     Usuario?                    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  clubes                      ProfessorClube[]
  escolinhas                  ProfessorEscolinha[]
  parceriasComoProfessorA     ProfessorParceiro[]         @relation("ProfessorA")
  parceriasComoProfessorB     ProfessorParceiro[]         @relation("ProfessorB")
  relacoesTreinamento         RelacaoTreinamento[]        @relation("RelacaoProfessor")
  TreinoAgendado              TreinoAgendado[]
  TreinoProfessorUso          TreinoProfessorUso[]
  treinosCriados              TreinoProgramado[]          @relation("TreinoProgramadoCriador")
  treinosProgramados          TreinoProgramado[]
  treinosParticipando         TreinoProgramadoProfessor[]
  TreinoRotina                TreinoRotina[]
  TreinoSalvo                 TreinoSalvo[]
  TreinoSalvoReuso            TreinoSalvoReuso[]
  turmasParticipando          TurmaProfessor[]

  @@index([organizacaoId])
}

model ProfessorClube {
  id          String    @id @default(uuid())
  professorId String
  clubeId     String
  papel       String?
  createdAt   DateTime  @default(now())
  clube       Clube     @relation(fields: [clubeId], references: [id], onDelete: Cascade)
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([professorId, clubeId])
  @@index([clubeId])
}

model ProfessorEscolinha {
  id          String    @id @default(uuid())
  professorId String
  escolinhaId String
  papel       String?
  createdAt   DateTime  @default(now())
  escolinha   Escolinha @relation(fields: [escolinhaId], references: [id], onDelete: Cascade)
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([professorId, escolinhaId])
  @@index([escolinhaId])
}

model ProfessorParceiro {
  id           String    @id @default(uuid())
  professorAId String
  professorBId String
  criadoEm     DateTime  @default(now())
  professorA   Professor @relation("ProfessorA", fields: [professorAId], references: [id], onDelete: Cascade)
  professorB   Professor @relation("ProfessorB", fields: [professorBId], references: [id], onDelete: Cascade)

  @@unique([professorAId, professorBId])
}

model OrganizacaoGestor {
  id          String          @id @default(uuid())
  tipo        OrganizacaoTipo
  ownerId     String
  professorId String
  papel       String?
  permissoes  Json?
  ativo       Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  professor   Professor       @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([tipo, ownerId, professorId])
  @@index([professorId])
  @@index([tipo, ownerId])
  @@index([ativo])
}

model Amigo {
  id        String   @id @default(uuid())
  usuarioId String
  amigoId   String
  local     String?
  seguindo  Boolean? @default(false)
  amigo     Usuario  @relation("AmigoUsuario", fields: [amigoId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation("UsuarioAmigo", fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Olheiro {
  id                     String            @id @default(uuid())
  usuarioId              String            @unique
  fotoUrl                String?
  headline               String?
  descricao              String?
  areaAtuacao            String?
  anosExperiencia        Int               @default(0)
  emailPublico           String?
  telefonePublico        String?
  siteOuLinkedin         String?
  colaboracaoClubeId     String?
  reputacaoScore         Int               @default(0)
  totalIndicacoes        Int               @default(0)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  clubeId                String?
  colaboracaoEscolinhaId String?
  colaboracaoProfessorId String?
  dataNascimento         DateTime?
  AtletaObservado        AtletaObservado[]
  Indicacao              Indicacao[]
  ListaOlheiro           ListaOlheiro[]
  Clube                  Clube?            @relation(fields: [clubeId], references: [id])
  colaboracaoClube       Clube?            @relation("OlheiroColabClube", fields: [colaboracaoClubeId], references: [id], onDelete: SetNull)
  colaboracaoEscolinha   Escolinha?        @relation("OlheiroColabEscolinha", fields: [colaboracaoEscolinhaId], references: [id], onDelete: SetNull)
  colaboracaoProfessor   Professor?        @relation("OlheiroColabProfessor", fields: [colaboracaoProfessorId], references: [id], onDelete: SetNull)
  usuario                Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([areaAtuacao])
  @@index([colaboracaoClubeId])
  @@index([colaboracaoProfessorId])
  @@index([colaboracaoEscolinhaId])
}

model Mensagem {
  id        String          @id @default(uuid())
  deId      String
  paraId    String
  conteudo  String
  criadaEm  DateTime        @default(now())
  lida      Boolean         @default(false)
  atletaId  String?
  desafioId String?
  postId    String?
  tipo      TipoMensagem    @default(NORMAL)
  usuarioId String?
  atleta    Atleta?         @relation("AtletaMensagens", fields: [atletaId], references: [id], onDelete: SetNull)
  de        Usuario         @relation("MensagensEnviadas", fields: [deId], references: [id], onDelete: Cascade)
  desafio   DesafioOficial? @relation("DesafioMensagemReferencia", fields: [desafioId], references: [id])
  para      Usuario         @relation("MensagensRecebidas", fields: [paraId], references: [id], onDelete: Cascade)
  post      Postagem?       @relation("PostMensagemReferencia", fields: [postId], references: [id])
  usuario   Usuario?        @relation("UsuarioMensagemReferencia", fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Atleta {
  id                            String                     @id @default(uuid())
  usuarioId                     String                     @unique
  nome                          String?
  sobrenome                     String?
  email                         String?                    @unique
  senhaHash                     String?
  idade                         Int
  cpf                           String?
  telefone1                     String?
  telefone2                     String?
  nacionalidade                 String?
  naturalidade                  String?
  posicao                       PosicaoCampo?
  altura                        Decimal?
  peso                          Decimal?
  seloQualidade                 String?
  foto                          String?
  categoria                     Categoria[]
  consentimento                 Boolean                    @default(false)
  clubeId                       String?
  escolinhaId                   String?
  statusConexao                 StatusConexao              @default(Pendente)
  dataCriacao                   DateTime                   @default(now())
  dataUltimaModificacao         DateTime?
  perfilTipoTreinoAtualizadoEm  DateTime?
  pontosTotal                   Int?                       @default(0)
  perfilTipoTreino              TipoTreino?
  dataNascimento                DateTime?
  contatoOlheiroPermitido       Boolean                    @default(false)
  contatoOlheiroConsentidoEm    DateTime?
  contatoOlheiroConsentidoPorId String?
  clube                         Clube?                     @relation(fields: [clubeId], references: [id], onDelete: SetNull)
  escolinha                     Escolinha?                 @relation(fields: [escolinhaId], references: [id], onDelete: SetNull)
  usuario                       Usuario                    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  AtletaElenco                  AtletaElenco[]
  AtletaHistoricoVinculo        AtletaHistoricoVinculo[]
  observadores                  AtletaObservado[]          @relation("ObservacaoAtleta")
  avaliacoesTreino              AvaliacaoTreino[]
  conquistas                    ConquistaVinculo[]         @relation("ConquistaAtleta")
  DocumentoFormador             DocumentoFormador[]
  EstatisticaAtleta             EstatisticaAtleta?
  Indicacao                     Indicacao[]
  ListaOlheiroItem              ListaOlheiroItem[]
  mensagens                     Mensagem[]                 @relation("AtletaMensagens")
  midias                        Midia[]
  pontuacao                     PontuacaoAtleta?
  postagens                     Postagem[]
  PresencaSessaoTreino          PresencaSessaoTreino[]
  Ranking                       Ranking?
  relacoesTreinamento           RelacaoTreinamento[]       @relation("RelacaoAtleta")
  solicitacoesVinculo           SolicitacaoVinculo[]
  submissoesDesafio             SubmissaoDesafio[]
  SubmissaoTreino               SubmissaoTreino[]
  TransferenciaFormador         TransferenciaFormador[]
  treinosAgendados              TreinoAgendado[]
  treinosLivres                 TreinoLivre[]
  treinosRecebidos              TreinoProgramadoRecebido[]
  TreinoRotinaAtribuicao        TreinoRotinaAtribuicao[]
  Video                         Video[]
  VinculoFormacao               VinculoFormacao[]
}

model TreinoProgramado {
  id                       String                           @id @default(uuid())
  codigo                   String?
  nome                     String
  descricao                String?
  nivel                    Nivel
  createdAt                DateTime                         @default(now())
  dataAgendada             DateTime?
  categoria                Categoria[]
  dicas                    String[]
  duracao                  Int?
  escolinhaId              String?
  clubeId                  String?
  expiraEm                 DateTime?
  imagemUrl                String?
  metas                    String?
  naoExpira                Boolean                          @default(false)
  pontuacao                Int?
  tipoTreino               TipoTreino?
  objetivo                 String?
  criadorProfessorId       String?
  professorId              String?
  metodologia              Boolean                          @default(false)
  parceiro                 Boolean                          @default(false)
  criadorUsuarioId         String?
  sessaoTreinoId           String?
  EstatisticaTreino        EstatisticaTreino?
  temporarios              ExercicioTemporario[]
  metodologiaAvulsaItens   MetodologiaAvulsaEstruturaItem[] @relation("TreinoProgramadoMetodologiaAvulsaItens")
  MetodologiaEstruturaItem MetodologiaEstruturaItem[]
  metodologiaItens         MetodologiaItem[]
  metodologias             MetodologiaTreino[]
  SessaoTreinoTurma        SessaoTreinoTurma[]
  treinoAgendado           TreinoAgendado[]
  favoritadoPor            TreinoFavorito[]
  TreinoProfessorUso       TreinoProfessorUso[]
  clube                    Clube?                           @relation(fields: [clubeId], references: [id], onDelete: SetNull)
  criadorProfessor         Professor?                       @relation("TreinoProgramadoCriador", fields: [criadorProfessorId], references: [id], onDelete: SetNull)
  criadorUsuario           Usuario?                         @relation("TreinoProgramadoCriadorUsuario", fields: [criadorUsuarioId], references: [id], onDelete: SetNull)
  escolinha                Escolinha?                       @relation(fields: [escolinhaId], references: [id], onDelete: SetNull)
  Professor                Professor?                       @relation(fields: [professorId], references: [id])
  sessaoTreino             TreinoSessao?                    @relation(fields: [sessaoTreinoId], references: [id], onDelete: SetNull)
  exercicios               TreinoProgramadoExercicio[]
  professores              TreinoProgramadoProfessor[]
  TreinoProgramadoRecebido TreinoProgramadoRecebido[]
  realizados               TreinoRealizado[]
  TreinoRotinaItem         TreinoRotinaItem[]

  @@index([sessaoTreinoId])
  @@index([criadorProfessorId])
  @@index([criadorUsuarioId])
}

model TreinoSessao {
  id              String             @id @default(uuid())
  nome            String
  nomeNormalizado String             @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  treinos         TreinoProgramado[]
}

model TreinoProgramadoProfessor {
  id                 String           @id @default(cuid())
  treinoProgramadoId String
  professorId        String
  papel              String?
  professor          Professor        @relation(fields: [professorId], references: [id], onDelete: Cascade)
  treinoProgramado   TreinoProgramado @relation(fields: [treinoProgramadoId], references: [id], onDelete: Cascade)

  @@unique([treinoProgramadoId, professorId])
  @@index([professorId])
  @@index([treinoProgramadoId])
}

model TreinoProgramadoExercicio {
  id                       String                  @id @default(uuid())
  treinoProgramadoId       String
  exercicioId              String?
  ordem                    Int
  repeticoes               String
  exercicioTemporarioId    String?
  exercicioPersonalizadoId String?
  descanso                 String?
  duracao                  String?
  series                   Int?
  descricaoExecucao        String?
  exercicio                Exercicio?              @relation(fields: [exercicioId], references: [id])
  exercicioPersonalizado   ExercicioPersonalizado? @relation(fields: [exercicioPersonalizadoId], references: [id])
  exercicioTemporario      ExercicioTemporario?    @relation(fields: [exercicioTemporarioId], references: [id])
  treinoProgramado         TreinoProgramado        @relation(fields: [treinoProgramadoId], references: [id], onDelete: Cascade)

  @@index([treinoProgramadoId])
  @@index([exercicioId])
  @@index([exercicioTemporarioId])
  @@index([exercicioPersonalizadoId])
}

model Exercicio {
  id                         String                       @id @default(uuid())
  codigo                     String                       @unique
  nome                       String                       @unique
  nivel                      Nivel
  categorias                 Categoria[]
  videoDemonstrativoUrl      String?
  createdAt                  DateTime                     @default(now())
  criadoPorId                String?
  descanso                   String?
  duracao                    String?
  espacoNecessario           EspacoExercicio?
  favorito                   Boolean                      @default(false)
  materiaisNecessarios       String?
  modoExecucao               ModoExecucaoExercicio?
  objetivo                   String?
  quantidadeAtletas          String?
  repeticoes                 String?
  series                     Int?
  tags                       String[]
  tipo                       TipoExercicio?
  updatedAt                  DateTime                     @default(now()) @updatedAt
  faixaEtaria                FaixaEtariaExercicio[]
  nomeNormalizado            String?                      @unique
  EstatisticaExercicio       EstatisticaExercicio?
  SessaoTreinoTurmaExercicio SessaoTreinoTurmaExercicio[]
  treinoProgramadoExercicios TreinoProgramadoExercicio[]
}

model ExercicioTemporario {
  id                         String                       @id @default(uuid())
  treinoProgramadoId         String
  codigo                     String?
  nome                       String
  descricao                  String?
  nivel                      Nivel
  videoDemonstrativoUrl      String?
  categorias                 Categoria[]
  videoPosterUrl             String?
  treinoProgramado           TreinoProgramado             @relation(fields: [treinoProgramadoId], references: [id], onDelete: Cascade)
  SessaoTreinoTurmaExercicio SessaoTreinoTurmaExercicio[]
  treinos                    TreinoProgramadoExercicio[]

  @@index([treinoProgramadoId])
}

model ExercicioPersonalizado {
  id                         String                       @id @default(uuid())
  nome                       String
  descricao                  String?
  nivel                      Nivel?
