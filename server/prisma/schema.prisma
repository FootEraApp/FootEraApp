}

model Turma {
  id          String     @id @default(uuid())
  nome        String
  categoria   String?
  descricao   String?
  ativo       Boolean    @default(true)
  escolinhaId String?
  escolinha   Escolinha? @relation(fields: [escolinhaId], references: [id], onDelete: SetNull)

  clubeId String?
  clube   Clube?  @relation(fields: [clubeId], references: [id], onDelete: SetNull)

  professorId String?
  professor   Professor? @relation(fields: [professorId], references: [id], onDelete: SetNull)

  membros TurmaUsuario[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Elenco            Elenco[]
  SessaoTreinoTurma SessaoTreinoTurma[]
  EventoConvocacao  EventoConvocacao[]
  EventoConvocado   EventoConvocado[]
}

model TurmaUsuario {
  id        String @id @default(uuid())
  turmaId   String
  usuarioId String

  turma   Turma   @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([turmaId, usuarioId])
  @@index([turmaId])
  @@index([usuarioId])
}

model TreinoSalvo {
  id                 String      @id @default(uuid())
  titulo             String
  descricao          String?
  nivel              Nivel?
  tipoTreino         TipoTreino?
  categoria          Categoria[]
  duracao            Int?
  dicas              String[]
  usuarioId          String
  treinoProgramadoId String
  createdAt          DateTime    @default(now())

  conteudo Json

  professorId String?
  escolinhaId String?
  clubeId     String?
  professor   Professor? @relation(fields: [professorId], references: [id], onDelete: Cascade)
  escolinha   Escolinha? @relation(fields: [escolinhaId], references: [id], onDelete: Cascade)
  clube       Clube?     @relation(fields: [clubeId], references: [id], onDelete: Cascade)

  criadoPorUsuarioId String?
  criadoPorUsuario   Usuario? @relation(fields: [criadoPorUsuarioId], references: [id], onDelete: SetNull)

  publico  Boolean @default(false)
  parceiro Boolean @default(false)

  expiraEm  DateTime?
  naoExpira Boolean   @default(false)

  reutilizacoesProfessores Int @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  reutilizadoPor TreinoSalvoReuso[]

  @@unique([usuarioId, treinoProgramadoId])
  @@index([professorId])
  @@index([escolinhaId])
  @@index([clubeId])
  @@index([publico, parceiro])
  @@index([expiraEm])
}

model TreinoSalvoReuso {
  id            String   @id @default(uuid())
  treinoSalvoId String
  professorId   String
  criadoEm      DateTime @default(now())

  treino    TreinoSalvo @relation(fields: [treinoSalvoId], references: [id], onDelete: Cascade)
  professor Professor   @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([treinoSalvoId, professorId])
  @@index([treinoSalvoId])
  @@index([professorId])
}

model EstatisticaTreino {
  treinoId        String    @id
  usosProfessores Int       @default(0)
  feitosAlunos    Int       @default(0)
  ultimoUsoEm     DateTime?
  ultimoFeitoEm   DateTime?

  treino TreinoProgramado @relation(fields: [treinoId], references: [id], onDelete: Cascade)
}

model TreinoProfessorUso {
  id          String   @id @default(uuid())
  treinoId    String
  professorId String
  usos        Int      @default(0)
  ultimoUsoEm DateTime @default(now())

  treino    TreinoProgramado @relation(fields: [treinoId], references: [id], onDelete: Cascade)
  professor Professor        @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([treinoId, professorId])
  @@index([professorId])
  @@index([treinoId])
}

model EstatisticaExercicio {
  exercicioId               String    @id
  inclusoesEmTreinos        Int       @default(0)
  ultimoIncluidoEm          DateTime?
  recomendadoPorProfessorId String?
  ultimoProfessorId         String?

  exercicio Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)

  recomendadoPorProfessor Professor? @relation("ExEstRec_Rec", fields: [recomendadoPorProfessorId], references: [id], onDelete: SetNull)
  ultimoProfessor         Professor? @relation("ExEstRec_Ult", fields: [ultimoProfessorId], references: [id], onDelete: SetNull)

  @@index([recomendadoPorProfessorId])
  @@index([ultimoProfessorId])
}

model TreinoRotina {
  id        String   @id @default(uuid())
  nome      String
  ownerTipo String
  ownerId   String
  inicio    DateTime
  fim       DateTime

  criadoPorUsuarioId String?
  criadoPorUsuario   Usuario? @relation(fields: [criadoPorUsuarioId], references: [id], onDelete: SetNull)

  professorId String?
  escolinhaId String?
  clubeId     String?
  professor   Professor? @relation(fields: [professorId], references: [id], onDelete: SetNull)
  escolinha   Escolinha? @relation(fields: [escolinhaId], references: [id], onDelete: SetNull)
  clube       Clube?     @relation(fields: [clubeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itens       TreinoRotinaItem[]
  atribuicoes TreinoRotinaAtribuicao[]

  @@index([inicio])
  @@index([fim])
}

model TreinoRotinaItem {
  id                 String    @id @default(uuid())
  rotinaId           String
  treinoProgramadoId String
  data               DateTime?
  diaDaSemana        Int?

  rotina TreinoRotina     @relation(fields: [rotinaId], references: [id], onDelete: Cascade)
  treino TreinoProgramado @relation(fields: [treinoProgramadoId], references: [id], onDelete: Cascade)

  @@index([rotinaId])
  @@index([treinoProgramadoId])
  @@index([diaDaSemana])
}

model TreinoRotinaAtribuicao {
  id                String  @id @default(uuid())
  rotinaId          String
  atletaId          String
  atletaObservadoId String?

  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  rotina    TreinoRotina     @relation(fields: [rotinaId], references: [id], onDelete: Cascade)
  atleta    Atleta           @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  observado AtletaObservado? @relation(fields: [atletaObservadoId], references: [id], onDelete: SetNull)

  ocorrencias TreinoAgendado[]

  @@unique([rotinaId, atletaId])
  @@index([atletaId])
  @@index([atletaObservadoId])
}

model Pagamento {
  id            String          @id @default(uuid())
  usuarioId     String
  plano         String
  periodicidade Periodicidade
  metodo        MetodoPagamento
  status        PagamentoStatus @default(PENDENTE)
  valor         Decimal         @db.Decimal(10, 2)
  moeda         String          @default("BRL")
  cupomId       String?
  provider      String?
  providerRef   String?
  criadoEm      DateTime        @default(now())
  pagoEm        DateTime?
  canceladoEm   DateTime?
  reembolsadoEm DateTime?
  updatedAt     DateTime        @updatedAt

  pagadorNome     String?
  pagadorEmail    String?
  pagadorCpf      String?
  pagadorTelefone String?

  cardBrand  String?
  cardLast4  String?
  cardExpMes Int?
  cardExpAno Int?

  pixCopiaECola        String?
  boletoLinhaDigitavel String?

  meta Json?

  usuario      Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cupom        Cupom?         @relation(fields: [cupomId], references: [id], onDelete: SetNull)
  CupomResgate CupomResgate[]

  @@unique([provider, providerRef])
  @@index([usuarioId, criadoEm])
  @@index([status])
  @@index([status, criadoEm])
}

model Cupom {
  id                     String         @id @default(uuid())
  codigo                 String         @unique
  tipo                   TipoCupom
  descontoPerc           Int?
  descontoFixo           Decimal?       @db.Decimal(10, 2)
  plano                  String?
  periodicidade          Periodicidade?
  ativo                  Boolean        @default(true)
  usosMax                Int?
  usosAtuais             Int            @default(0)
  expiraEm               DateTime?
  concedidoParaUsuarioId String?
  transferivel           Boolean        @default(false)

  criadoEm           DateTime @default(now())
  criadoPorUsuarioId String?
  criadoPor          Usuario? @relation(fields: [criadoPorUsuarioId], references: [id], onDelete: SetNull)

  resgates  CupomResgate[]
  Pagamento Pagamento[]

  @@index([ativo])
  @@index([codigo])
}

model CupomResgate {
  id          String   @id @default(uuid())
  cupomId     String
  usuarioId   String
  resgatadoEm DateTime @default(now())
  pagamentoId String?

  cupom     Cupom      @relation(fields: [cupomId], references: [id], onDelete: Cascade)
  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pagamento Pagamento? @relation(fields: [pagamentoId], references: [id], onDelete: SetNull)

  @@unique([cupomId, usuarioId])
  @@index([usuarioId])
}

model EventoElenco {
  id            String          @id @default(uuid())
  titulo        String
  tipo          EventoChaveTipo @default(MATA_MATA)
  status        String          @default("ABERTO")
  participantes String[]
  ownerTipo     String
  ownerId       String
  criadoEm      DateTime        @default(now())
  atualizadoEm  DateTime        @updatedAt

  Partida PartidaElenco[]
}

model PartidaElenco {
  id                 String     @id @default(uuid())
  eventoId           String
  fase               Int
  ordem              Int
  elencoAId          String?
  elencoBId          String?
  placarA            Int        @default(0)
  placarB            Int        @default(0)
  faltasA            Int        @default(0)
  faltasB            Int        @default(0)
  status             JogoStatus @default(PENDENTE)
  iniciadoEm         DateTime?
  finalizadoEm       DateTime?
  vencedorElencoId   String?
  proximaPartidaId   String?
  proximaPartidaSlot String?

  evento EventoElenco @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([eventoId, fase])
  @@index([proximaPartidaId])
}

model UsageCounter {
  id          String   @id @default(cuid())
  userId      String
  key         String
  periodRef   String
  windowKind  String
  windowStart DateTime
  windowEnd   DateTime
  count       Int      @default(0)
  value       Int      @default(0)
  meta        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, key, windowKind, windowStart])
  @@index([key, windowKind, windowStart])
}

model EventoPagamento {
  id              String   @id @default(cuid())
  providerEventId String   @unique
  tipo            String
  recebidoEm      DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  usuarioId  String?
  ip         String?
  userAgent  String?
  acao       String
  entidade   String?
  entidadeId String?
  descricao  String?
  meta       Json?
  criadoEm   DateTime @default(now())
}

model AtletaHistoricoVinculo {
  id String @id @default(uuid())

  atletaId    String?
  atleta      Atleta? @relation(fields: [atletaId], references: [id], onDelete: SetNull)
  professorId String?
  escolinhaId String?
  clubeId     String?

  professor Professor? @relation(fields: [professorId], references: [id], onDelete: SetNull)
  escolinha Escolinha? @relation(fields: [escolinhaId], references: [id], onDelete: SetNull)
  clube     Clube?     @relation(fields: [clubeId], references: [id], onDelete: SetNull)

  nome          String?
  sobrenome     String?
  email         String?
  cpf           String?
  foto          String?
  idade         Int?
  posicao       PosicaoCampo?
  nacionalidade String?
  naturalidade  String?
  altura        Decimal?
  peso          Decimal?
  categoria     Categoria[]
  seloQualidade String?

  inicioVinculo DateTime?
  fimVinculo    DateTime?

  criadoEm DateTime @default(now())
  expiraEm DateTime

  @@index([atletaId])
  @@index([professorId])
  @@index([escolinhaId])
  @@index([clubeId])
  @@index([expiraEm])
}

model SessaoTreinoTurma {
  id                 String                  @id @default(uuid())
  treinoProgramadoId String
  turmaId            String
  criadorId          String
  data               DateTime
  status             StatusSessaoTreinoTurma @default(AGENDADO)
  startedAt          DateTime?
  finishedAt         DateTime?
  observacoes        String?
  duracaoMinutosReal Int?
  penalidadeAtraso   Boolean                 @default(false)

  treino  TreinoProgramado @relation(fields: [treinoProgramadoId], references: [id], onDelete: Cascade)
  turma   Turma            @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  criador Usuario          @relation(fields: [criadorId], references: [id], onDelete: Cascade)

  presencas  PresencaSessaoTreino[]
  exercicios SessaoTreinoTurmaExercicio[]
}

model PresencaSessaoTreino {
  id       String  @id @default(uuid())
  sessaoId String
  atletaId String
  presente Boolean @default(true)

  sessao SessaoTreinoTurma @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  atleta Atleta            @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([sessaoId, atletaId])
}

model SessaoTreinoTurmaExercicio {
  id          String    @id @default(uuid())
  sessaoId    String
  ordem       Int?
  concluido   Boolean   @default(false)
  concluidoEm DateTime?

  exercicioId String?
  exercicio   Exercicio? @relation(fields: [exercicioId], references: [id])

  exercicioTemporarioId String?
  exercicioTemporario   ExercicioTemporario? @relation(fields: [exercicioTemporarioId], references: [id])

  sessao SessaoTreinoTurma @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@index([sessaoId])
}

model EventoConvocacao {
  id          String   @id @default(uuid())
  eventoId    String
  turmaId     String
  nome        String   @default("Convocação")
  formacao    String?
  escala      Json?
  reservasIds String[] @default([])
  criadoEm    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  professorId String?
  clubeId     String?
  escolinhaId String?

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  turma  Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([eventoId, turmaId])
}

model EventoConvocado {
  id        String           @id @default(uuid())
  eventoId  String
  turmaId   String
  atletaId  String
  posicao   String?
  tipo      String
  status    ConvocacaoStatus @default(PENDENTE)
  createdAt DateTime         @default(now())

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  turma  Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([eventoId, turmaId, atletaId])
}

model Notificacao {
  id        String   @id @default(uuid())
  usuarioId String
  titulo    String
  mensagem  String
  link      String?
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

