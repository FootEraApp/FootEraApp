generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Usuario {
  id                       String              @id @default(uuid())
  nomeDeUsuario            String              @unique
  senhaHash                String
  nome                     String
  email                    String              @unique
  foto                     String?
  tipo                     TipoUsuario
  cidade                   String?
  estado                   String?
  pais                     String?
  bairro                   String?
  cpf                      String?
  dataNascimento           DateTime?
  responsavelNome          String?
  responsavelEmail         String?
  responsavelTelefone      String?
  configuracoesPrivacidade Json?
  dataCriacao              DateTime            @default(now())
  codigo                   String?
  verified                 Boolean             @default(false)
  EmailVerification        EmailVerification[]
  assinatura               Assinatura?
  administrador            Administrador?

  amigosDe               Amigo[]                   @relation("AmigoUsuario")
  amigos                 Amigo[]                   @relation("UsuarioAmigo")
  atividadesRecentes     AtividadeRecente[]
  atleta                 Atleta?
  clube                  Clube?
  comentarios            Comentario[]
  curtidas               Curtida[]
  desafiosCriados        DesafioEmGrupo[]          @relation("CriadorDesafioEmGrupo")
  escolinha              Escolinha?
  favoritadoPor          FavoritoUsuario[]         @relation("UsuarioFavorito")
  favoritos              FavoritoUsuario[]         @relation("UsuarioFavoritador")
  gruposDono             Grupo[]                   @relation("GruposQuePossuo")
  logsErro               LogErro[]
  MembroGrupo            MembroGrupo[]
  mensagensEnviadas      Mensagem[]                @relation("MensagensEnviadas")
  mensagensRecebidas     Mensagem[]                @relation("MensagensRecebidas")
  mensagensReferenciando Mensagem[]                @relation("UsuarioMensagemReferencia")
  MensagemGrupo          MensagemGrupo[]
  olheiro                Olheiro?
  PasswordReset          PasswordReset[]
  postagens              Postagem[]
  professor              Professor?
  seguidores             Seguidor[]                @relation("Seguido")
  seguindo               Seguidor[]                @relation("Seguidor")
  solicitacoesRecebidas  SolicitacaoTreino[]       @relation("SolicitacoesRecebidas")
  solicitacoesEnviadas   SolicitacaoTreino[]       @relation("SolicitacoesEnviadas")
  submissaoDesafios      SubmissaoDesafio[]
  submissaoEmGrupo       SubmissaoDesafioEmGrupo[]
  submissaoTreinos       SubmissaoTreino[]
  treinoRealizado        TreinoRealizado[]
  desafiosEmGrupo        DesafioEmGrupo[]          @relation("MembrosDesafioEmGrupo")
  Consentimento          Consentimento[]
  Turmas                 TurmaUsuario[]
  TreinoUsuario          TreinoUsuario[]
  SubmissionChecklist    SubmissionChecklist[]
  TreinoSalvo            TreinoSalvo[]
  TreinoRotina           TreinoRotina[]
  Pagamento              Pagamento[]
  Cupom                  Cupom[]
  CupomResgate           CupomResgate[]
  LogAuditoria           LogAuditoria[]
  inscricoesEvento       InscricaoEvento[]
  convitesEvento         InscricaoEvento[]         @relation("ConvitesEvento")
  feedbacks              Feedback[]
  SessaoTreinoTurma      SessaoTreinoTurma[]
  Notificacao            Notificacao[]
  AvaliacaoTreino        AvaliacaoTreino[]
}

model EmailVerification {
  id        String    @id @default(uuid())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String    @unique
  token     String    @unique
  criadoEm  DateTime  @default(now())
  expiraEm  DateTime
  usadoEm   DateTime?
}

model Assinatura {
  id                     String    @id @default(uuid())
  usuarioId              String    @unique
  plano                  String
  periodicidade          String
  startsAt               DateTime
  renovaEm               DateTime
  canceledAt             DateTime?
  ativo                  Boolean   @default(true)
  lembreteEnviado        Boolean   @default(false)
  usuario                Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  providerSubscriptionId String?   @unique

  @@index([startsAt])
  @@index([canceledAt])
}

model Professor {
  id                  String               @id @default(uuid())
  codigo              String               @unique
  cref                String?
  areaFormacao        String
  escola              String?
  fotoUrl             String?
  nome                String               @unique
  usuarioId           String?              @unique
  statusCref          StatusCref?
  qualificacoes       String[]
  certificacoes       String[]
  observacoes         AtletaObservado[]    @relation("ObservacaoProfessor")
  usuario             Usuario?             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  relacoesTreinamento RelacaoTreinamento[] @relation("RelacaoProfessor")
  treinosProgramados  TreinoProgramado[]
  escolinhaId         String?
  clubeId             String?
  organizacaoId       String?
  email               String?              @db.VarChar(191)

  escolinha        Escolinha?         @relation(fields: [escolinhaId], references: [id], onDelete: SetNull)
  clube            Clube?             @relation(fields: [clubeId], references: [id], onDelete: SetNull)
  Turma            Turma[]
  atletas          Atleta[]
  TreinoSalvo      TreinoSalvo[]
  TreinoSalvoReuso TreinoSalvoReuso[]

  estatExerciciosRecomendados EstatisticaExercicio[]   @relation("ExEstRec_Rec")
  estatExerciciosUltimo       EstatisticaExercicio[]   @relation("ExEstRec_Ult")
  TreinoAgendado              TreinoAgendado[]
  TreinoProfessorUso          TreinoProfessorUso[]
  TreinoRotina                TreinoRotina[]
  AtletaHistoricoVinculo      AtletaHistoricoVinculo[]

  @@index([escolinhaId])
  @@index([clubeId])
  @@index([organizacaoId])
}

model Amigo {
  id        String   @id @default(uuid())
  usuarioId String
  amigoId   String
  local     String?
  seguindo  Boolean? @default(false)
  amigo     Usuario  @relation("AmigoUsuario", fields: [amigoId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation("UsuarioAmigo", fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Olheiro {
  id                 String            @id @default(uuid())
  usuarioId          String            @unique
  fotoUrl            String?
  headline           String?
  descricao          String?
  areaAtuacao        String?
  anosExperiencia    Int               @default(0)
  emailPublico       String?
  telefonePublico    String?
  siteOuLinkedin     String?
  colaboracaoClubeId String?
  reputacaoScore     Int               @default(0)
  totalIndicacoes    Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  AtletaObservado    AtletaObservado[]
  Indicacao          Indicacao[]
  colaboracaoClube   Clube?            @relation(fields: [colaboracaoClubeId], references: [id], onDelete: SetNull)
  usuario            Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ListaOlheiro       ListaOlheiro[]

  @@index([areaAtuacao])
  @@index([colaboracaoClubeId])
}

model Mensagem {
  id        String          @id @default(uuid())
  deId      String
  paraId    String
  conteudo  String
  criadaEm  DateTime        @default(now())
  lida      Boolean         @default(false)
  atletaId  String?
  desafioId String?
  postId    String?
  tipo      TipoMensagem    @default(NORMAL)
  usuarioId String?
  atleta    Atleta?         @relation("AtletaMensagens", fields: [atletaId], references: [id], onDelete: SetNull)
  de        Usuario         @relation("MensagensEnviadas", fields: [deId], references: [id], onDelete: Cascade)
  desafio   DesafioOficial? @relation("DesafioMensagemReferencia", fields: [desafioId], references: [id])
  para      Usuario         @relation("MensagensRecebidas", fields: [paraId], references: [id], onDelete: Cascade)
  post      Postagem?       @relation("PostMensagemReferencia", fields: [postId], references: [id])
  usuario   Usuario?        @relation("UsuarioMensagemReferencia", fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Atleta {
  id                            String                     @id @default(uuid())
  usuarioId                     String                     @unique
  nome                          String?
  sobrenome                     String?
  email                         String?                    @unique
  senhaHash                     String?
  idade                         Int
  cpf                           String?
  telefone1                     String?
  telefone2                     String?
  nacionalidade                 String?
  naturalidade                  String?
  posicao                       PosicaoCampo?
  altura                        Decimal?
  peso                          Decimal?
  seloQualidade                 String?
  foto                          String?
  categoria                     Categoria[]
  consentimento                 Boolean                    @default(false)
  clubeId                       String?
  escolinhaId                   String?
  professorId                   String?
  statusConexao                 StatusConexao              @default(Pendente)
  dataCriacao                   DateTime                   @default(now())
  dataUltimaModificacao         DateTime?
  perfilTipoTreinoAtualizadoEm  DateTime?
  pontosTotal                   Int?                       @default(0)
  perfilTipoTreino              TipoTreino?
  professor                     Professor?                 @relation(fields: [professorId], references: [id], onDelete: SetNull)
  clube                         Clube?                     @relation(fields: [clubeId], references: [id], onDelete: SetNull)
  escolinha                     Escolinha?                 @relation(fields: [escolinhaId], references: [id], onDelete: SetNull)
  usuario                       Usuario                    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  AtletaElenco                  AtletaElenco[]
  observadores                  AtletaObservado[]          @relation("ObservacaoAtleta")
  EstatisticaAtleta             EstatisticaAtleta?
  Indicacao                     Indicacao[]
  mensagens                     Mensagem[]                 @relation("AtletaMensagens")
  midias                        Midia[]
  pontuacao                     PontuacaoAtleta?
  postagens                     Postagem[]
  Ranking                       Ranking?
  relacoesTreinamento           RelacaoTreinamento[]       @relation("RelacaoAtleta")
  solicitacoesVinculo           SolicitacaoVinculo[]
  submissoesDesafio             SubmissaoDesafio[]
  SubmissaoTreino               SubmissaoTreino[]
  treinosAgendados              TreinoAgendado[]
  treinosLivres                 TreinoLivre[]
  treinosRecebidos              TreinoProgramadoRecebido[]
  Video                         Video[]
  VinculoFormacao               VinculoFormacao[]
  TransferenciaFormador         TransferenciaFormador[]
  DocumentoFormador             DocumentoFormador[]
  TreinoRotinaAtribuicao        TreinoRotinaAtribuicao[]
  ListaOlheiroItem              ListaOlheiroItem[]
  dataNascimento                DateTime?
  contatoOlheiroPermitido       Boolean                    @default(false)
  contatoOlheiroConsentidoEm    DateTime?
  contatoOlheiroConsentidoPorId String?
  AtletaHistoricoVinculo        AtletaHistoricoVinculo[]
  PresencaSessaoTreino          PresencaSessaoTreino[]
  avaliacoesTreino              AvaliacaoTreino[]

  @@index([perfilTipoTreino])
  @@index([professorId])
}

model TreinoProgramado {
  id                       String                      @id @default(uuid())
  codigo                   String                      @unique
  nome                     String                      @unique
  descricao                String?
  nivel                    Nivel
  dataAgendada             DateTime?
  professorId              String?
  createdAt                DateTime                    @default(now())
  categoria                Categoria[]
  dicas                    String[]
  duracao                  Int?
  escolinhaId              String?
  objetivo                 String?
  clubeId                  String?
  expiraEm                 DateTime?
  imagemUrl                String?
  metas                    String?
  naoExpira                Boolean                     @default(false)
  pontuacao                Int?
  tipoTreino               TipoTreino?
  temporarios              ExercicioTemporario[]
  treinoAgendado           TreinoAgendado[]
  clube                    Clube?                      @relation(fields: [clubeId], references: [id], onDelete: SetNull)
  escolinha                Escolinha?                  @relation(fields: [escolinhaId], references: [id], onDelete: SetNull)
  professor                Professor?                  @relation(fields: [professorId], references: [id], onDelete: SetNull)
  exercicios               TreinoProgramadoExercicio[]
  TreinoProgramadoRecebido TreinoProgramadoRecebido[]
  realizados               TreinoRealizado[]
  EstatisticaTreino        EstatisticaTreino[]
  TreinoProfessorUso       TreinoProfessorUso[]
  TreinoRotinaItem         TreinoRotinaItem[]
  SessaoTreinoTurma        SessaoTreinoTurma[]
}

model TreinoProgramadoExercicio {
  id                    String               @id @default(uuid())
  treinoProgramadoId    String
  exercicioId           String?
  ordem                 Int
  repeticoes            String
  exercicioTemporarioId String?
  exercicio             Exercicio?           @relation(fields: [exercicioId], references: [id])
  exercicioTemporario   ExercicioTemporario? @relation(fields: [exercicioTemporarioId], references: [id])
  treinoProgramado      TreinoProgramado     @relation(fields: [treinoProgramadoId], references: [id], onDelete: Cascade)

  @@index([treinoProgramadoId])
  @@index([exercicioId])
  @@index([exercicioTemporarioId])
}

model Exercicio {
  id                         String                       @id @default(uuid())
  codigo                     String                       @unique
  nome                       String                       @unique
  descricao                  String?
  nivel                      Nivel
  categorias                 Categoria[]
  videoDemonstrativoUrl      String?
  treinoProgramadoExercicios TreinoProgramadoExercicio[]
  EstatisticaExercicio       EstatisticaExercicio[]
  SessaoTreinoTurmaExercicio SessaoTreinoTurmaExercicio[]
}

model ExercicioTemporario {
  id                         String                       @id @default(uuid())
  treinoProgramadoId         String
  codigo                     String?
  nome                       String
  descricao                  String?
  nivel                      Nivel
  videoDemonstrativoUrl      String?
  categorias                 Categoria[]
  treinoProgramado           TreinoProgramado             @relation(fields: [treinoProgramadoId], references: [id], onDelete: Cascade)
  treinos                    TreinoProgramadoExercicio[]
  SessaoTreinoTurmaExercicio SessaoTreinoTurmaExercicio[]

  @@index([treinoProgramadoId])
}

model DesafioOficial {
  id               String             @id @default(uuid())
  titulo           String             @unique
  descricao        String
  imagemUrl        String?
  nivel            Nivel
  categoria        Categoria[]
  createdAt        DateTime           @default(now())
  prazoSubmissao   DateTime?
  pontuacao        Int?
  regras           String?
  tipoMetrificacao String?            @map("tipoMetrificação")
  desafiosEmGrupo  DesafioEmGrupo[]   @relation("DesafioOficial_EmGrupo")
  mensagens        Mensagem[]         @relation("DesafioMensagemReferencia")
  submissoes       SubmissaoDesafio[]
}

model Seguidor {
  id                String  @id @default(uuid())
  seguidoUsuarioId  String
  seguidorUsuarioId String
  seguidoUsuario    Usuario @relation("Seguido", fields: [seguidoUsuarioId], references: [id], onDelete: Cascade)
  seguidorUsuario   Usuario @relation("Seguidor", fields: [seguidorUsuarioId], references: [id], onDelete: Cascade)
}

model RelacaoTreinamento {
  id            String     @id @default(uuid())
  professorId   String?
  atletaId      String?
  escolinhaId   String?
  clubeId       String?
  organizacaoId String?
  ativo         Boolean?
  criadoEm      DateTime   @default(now())
  atleta        Atleta?    @relation("RelacaoAtleta", fields: [atletaId], references: [id], onDelete: SetNull)
  clube         Clube?     @relation("RelacaoClube", fields: [clubeId], references: [id], onDelete: SetNull)
  escolinha     Escolinha? @relation("RelacaoEscolinha", fields: [escolinhaId], references: [id], onDelete: SetNull)
  professor     Professor? @relation("RelacaoProfessor", fields: [professorId], references: [id], onDelete: SetNull)
  encerradoEm   DateTime?

  @@unique([professorId, atletaId, escolinhaId, clubeId])
}

model AtletaObservado {
  id           String     @id @default(uuid())
  professorId  String?
  escolinhaId  String?
  clubeId      String?
  atletaId     String
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  olheiroId    String?
  atleta       Atleta     @relation("ObservacaoAtleta", fields: [atletaId], references: [id], onDelete: Cascade)
  clube        Clube?     @relation("ObservacaoClube", fields: [clubeId], references: [id], onDelete: SetNull)
  escolinha    Escolinha? @relation("ObservacaoEscolinha", fields: [escolinhaId], references: [id], onDelete: SetNull)
  olheiro      Olheiro?   @relation(fields: [olheiroId], references: [id], onDelete: SetNull)

  professor Professor? @relation("ObservacaoProfessor", fields: [professorId], references: [id], onDelete: Cascade)

  TreinoRotinaAtribuicao TreinoRotinaAtribuicao[]

  @@unique([professorId, escolinhaId, clubeId, olheiroId, atletaId], map: "AtletaObservado_owner_atleta_key")
  @@index([atletaId])
  @@index([professorId])
  @@index([escolinhaId])
  @@index([clubeId])
  @@index([olheiroId])
}

model Postagem {
  id                String       @id @default(uuid())
  conteudo          String       @unique
  imagemUrl         String?
  videoUrl          String?
  tipoMidia         TipoMidia?
  dataCriacao       DateTime     @default(now())
  usuarioId         String
  atletaId          String?
  clubeId           String?
  escolinhaId       String?
  compartilhamentos Int?         @default(0)
  repostOfId        String?
  repostOf          Postagem?    @relation("Reposts", fields: [repostOfId], references: [id])
  repostedBy        Postagem[]   @relation("Reposts")
  reposts           Int          @default(0)
  oculto            Boolean      @default(false)
  reportedCount     Int          @default(0)
  comentarios       Comentario[]
  curtidas          Curtida[]
  logsErro          LogErro[]
  mensagens         Mensagem[]   @relation("PostMensagemReferencia")
  atleta            Atleta?      @relation(fields: [atletaId], references: [id], onDelete: SetNull)
  clube             Clube?       @relation(fields: [clubeId], references: [id], onDelete: SetNull)
  escolinha         Escolinha?   @relation(fields: [escolinhaId], references: [id], onDelete: SetNull)
  usuario           Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, conteudo, repostOfId])
  @@index([repostOfId])
}

model Midia {
  id                 String       @id @default(uuid())
  url                String
  tipo               TipoMidia
  dataCriacao        DateTime     @default(now())
  dataEnvio          DateTime
  descricao          String
  titulo             String
  atletaId           String?
  escolinhaId        String?
  clubeId            String?
  submissaoDesafioId String?
  submissaoTreinoId  String?
  criadoEm           DateTime     @default(now())
  durationSec        Int?
  width              Int?
  height             Int?
  sizeBytes          Int?
  processedUrl       String?
  thumbUrl           String?
  fps                Int?
  lastAccessAt       DateTime?
  storageClass       StorageClass
  atualizadoEm       DateTime     @updatedAt

  atleta           Atleta?           @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  clube            Clube?            @relation(fields: [clubeId], references: [id], onDelete: SetNull)
  escolinha        Escolinha?        @relation(fields: [escolinhaId], references: [id], onDelete: SetNull)
  submissaoDesafio SubmissaoDesafio? @relation("Midias_SubmissaoDesafio", fields: [submissaoDesafioId], references: [id], onDelete: Cascade)
  submissaoTreino  SubmissaoTreino?  @relation("Midias_SubmissaoTreino", fields: [submissaoTreinoId], references: [id], onDelete: Cascade)
}

model Escolinha {
  id                     String                   @id @default(uuid())
  usuarioId              String?                  @unique
  nome                   String                   @unique
  cnpj                   String?                  @unique
  telefone1              String?
  telefone2              String?
  email                  String?                  @unique
  siteOficial            String?
  sede                   String?
  logradouro             String?
  numero                 String?
  complemento            String?
  bairro                 String?
  cidade                 String?
  estado                 String?
  pais                   String?
  cep                    String?
  logo                   String?
  dataCriacao            DateTime                 @default(now())
  atletas                Atleta[]
  observacoes            AtletaObservado[]        @relation("ObservacaoEscolinha")
  usuario                Usuario?                 @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  midias                 Midia[]
  postagens              Postagem[]
  relacoesTreinamento    RelacaoTreinamento[]     @relation("RelacaoEscolinha")
  treinoProgramado       TreinoProgramado[]
  Professor              Professor[]
  Turma                  Turma[]
  TreinoSalvo            TreinoSalvo[]
  TreinoRotina           TreinoRotina[]
  eventos                Evento[]
  AtletaHistoricoVinculo AtletaHistoricoVinculo[]
}

model Comentario {
  id            String            @id @default(uuid())
  conteudo      String
  dataCriacao   DateTime          @default(now())
  usuarioId     String
  postagemId    String?
  submissaoId   String?
  oculto        Boolean           @default(false)
  reportedCount Int               @default(0)
  postagem      Postagem?         @relation(fields: [postagemId], references: [id])
  submissao     SubmissaoDesafio? @relation(fields: [submissaoId], references: [id], onDelete: Cascade)
  usuario       Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([postagemId])
  @@index([submissaoId])
}

model Clube {
  id          String   @id @default(uuid())
  usuarioId   String   @unique
  nome        String   @unique
  cnpj        String?  @unique
  telefone1   String?
  telefone2   String?
  email       String?  @unique
  siteOficial String?  @unique
  sede        String?
  estadio     String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  pais        String?
  cep         String?
  logo        String?
  dataCriacao DateTime @default(now())
  descricao   String?
  responsavel String?

  categorias             Categoria[]
  atletas                Atleta[]
  observacoes            AtletaObservado[]        @relation("ObservacaoClube")
  usuario                Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  Evento                 Evento[]
  Indicacao              Indicacao[]
  midias                 Midia[]
  Olheiro                Olheiro[]
  postagens              Postagem[]
  relacoesTreinamento    RelacaoTreinamento[]     @relation("RelacaoClube")
  treinoProgramado       TreinoProgramado[]
  Professor              Professor[]
  Turma                  Turma[]
  TreinoSalvo            TreinoSalvo[]
  TreinoRotina           TreinoRotina[]
  AtletaHistoricoVinculo AtletaHistoricoVinculo[]
}

model SolicitacaoVinculo {
  id           String   @id @default(uuid())
  atletaId     String
  entidadeId   String
  tipoEntidade String
  status       String?
  criadoEm     DateTime @default(now())
  atleta       Atleta   @relation(fields: [atletaId], references: [id], onDelete: Cascade)
}

model SolicitacaoTreino {
  id             String   @id @default(uuid())
  remetenteId    String
  destinatarioId String
  status         String?
  criadoEm       DateTime @default(now())
  destinatario   Usuario  @relation("SolicitacoesRecebidas", fields: [destinatarioId], references: [id], onDelete: Cascade)
  remetente      Usuario  @relation("SolicitacoesEnviadas", fields: [remetenteId], references: [id], onDelete: Cascade)
}

model SubmissaoDesafio {
  id                 String                    @id @default(uuid())
  atletaId           String
  desafioId          String
  videoUrl           String
  aprovado           Boolean?
  createdAt          DateTime                  @default(now())
  usuarioId          String?
  observacao         String?
  conteudo           Json?
  resultado          Float?
  resultadoDeclarado Float?
  tempoMs            Int?
  unidadeResultado   String?
  repeticoes         Int?
  comentarios        Comentario[]
  curtidas           Curtida[]
  midias             Midia[]                   @relation("Midias_SubmissaoDesafio")
