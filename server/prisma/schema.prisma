model Creator {
  id                 String         @id @default(uuid())
  usuarioId          String         @unique
  nomePublico        String?
  headline           String?
  bio                String?
  nicho              String?
  avatarUrl          String?
  bannerUrl          String?
  siteUrl            String?
  instagramUrl       String?
  youtubeUrl         String?
