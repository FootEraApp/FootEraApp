  metodologia         Metodologia?       @relation(fields: [metodologiaId], references: [id], onDelete: SetNull)

  @@unique([provider, providerRef])
  @@index([creatorId])
  @@index([compradorId])
  @@index([metodologiaId])
  @@index([metodologiaAvulsaId])
  @@index([status])
}

