# ===== Runtime =====
NODE_ENV=production
PORT=3001                 # se sua infra já injeta PORT, pode remover

# ===== URLs (compat chain) =====
# Estas 4 variáveis garantem compatibilidade com todos os pontos do código:
BACKEND_URL=https://api.footera.app.br
API_BASE_URL=https://api.footera.app.br
APP_URL=https://api.footera.app.br
BASE_URL=https://api.footera.app.br

FRONTEND_URL=https://footera.app.br
CLIENT_BASE_URL=https://footera.app.br

# ===== Banco de dados (RDS) =====
# Ajuste usuário, senha e host. Mantenha sslmode=require em produção.
DATABASE_URL="postgresql://SEU_USUARIO:SEU_PASSWORD@SEU_HOST_RDS:5432/footera?schema=public&sslmode=require"

# ===== Auth =====
JWT_SECRET=seuSegredoForte
JWT_VERIFY_TTL=2d

# ===== E-mail =====
EMAIL_FROM="FootEra <no-reply@footera.app.br>"
SUPPORT_EMAIL=suporte@footera.app.br

# ===== AWS (se usar S3/SES/WorkMail) =====
AWS_ACCESS_KEY_ID=SEU_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=SUA_SECRET_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=footera-midias
