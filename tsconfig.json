{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@/*": ["client/src/*"],
      "server/*": ["server/*"],
      "@shared/*": ["shared/*"]
    },
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "types": ["node", "vite/client"],
    "jsx": "react-jsx"
  },
  "include": [
    "server/**/*.ts",
    "client/**/*.ts",
    "client/**/*.tsx",
    "client/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public",
    "server/_ignore.storage.ts",
    "server/**/_ignore*.ts"
  ]
}