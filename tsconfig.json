{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "Nodenext",
    "baseUrl": ".",
    "paths": {
      "@/*": ["client/src/*"],
      "server/*": ["server/*"],
      "@shared/*": ["shared/*"]
    },
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": false,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "typeRoots": ["./server/types", "./node_modules/@types"],
    "types": ["node", "express"],
    "jsx": "react-jsx"
  },
  "include": [
    "server/**/*.ts",
    "server"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public",
    "server/_ignore.storage.ts",
    "server/**/_ignore*.ts"
  ]
}