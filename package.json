{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:server": "cross-env NODE_OPTIONS=--dns-result-order=ipv4first NODE_ENV=development tsx server/index.ts",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "check:routes-auth": "node server/scripts/checkRoutesAuth.mjs",
    "db:push": "drizzle-kit push",
    "backfill:snapshots": "tsx scripts/backfillSnapshots.ts",
    "clean:expired-trainings": "tsx server/routes/removerTreinosExpirados.ts",
    "backfill:exercicios": "tsx scripts/backfillTreinoProgramadoExercicios.ts",
    "prisma:studio": "prisma studio --schema server/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema server/prisma/schema.prisma",
    "seed:ex": "tsx server/prisma/seed_exercicios.ts",
    "seed:base": "tsx server/prisma/seed.ts",
    "seed:all": "npm run seed:ex && npm run seed:base",
    "release:check": "node scripts/release-check.mjs",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "e2e:server": "npm --prefix server run dev",
    "e2e:client": "npm --prefix client run dev",
    "e2e:test": "playwright test",
    "test:routes": "playwright test --project=public",
    "test:admin": "playwright test --project=admin",
    "test:users": "playwright test --project=atleta --project=professor --project=clube --project=escola --project=olheiro",
    "test:creators": "playwright test --project=professor-creator --project=clube-creator --project=escola-creator",
    "test:e2e:all": "playwright test",
    "test:e2e": "playwright test",
    "test:predeploy": "npm run check:routes-auth && npm --prefix server run release:deploy-check && npm run test:routes && npm run test:admin && npm run test:users && npm run test:creators",
    "test:routes:ui": "playwright test tests/e2e/routes-public.spec.ts --ui",
    "test:routes:report": "playwright show-report",
    "test": "node scripts/run-e2e.mjs",
    "test:cmd": "start-server-and-test \"npm run e2e:server\" http://localhost:3001/api/health \"start-server-and-test \\\"npm run e2e:client\\\" http://localhost:5173 \\\"npm run e2e:test\\\"\""
  },
